---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import Marker from "../../components/Marker.astro";
import { formatDate, sortByDateDesc } from "../../lib/posts";

const lifting = sortByDateDesc(
  await getCollection("posts", ({ data }) => !data.draft && data.tags.includes("lifting")),
);
const coins = sortByDateDesc(await getCollection("posts", ({ data }) => !data.draft && data.tags.includes("coins")));
---

<BaseLayout
  title="Hobbies | Dogus Ural"
  description="Dogus Ural's hobbies: a cabinet of Greek, Roman, Baktrian and Islamic coins, a lifting log, and a reading shelf."
>
  <section class="section">
    <div class="container">
      <PageHead title="Hobbies">
        <p>Training logs, numismatics notes, and a reading shelf.</p>
      </PageHead>

      <div class="hobby-grid">
      <article class="card hobby-block">
        <Marker shape="se">Lifting</Marker>
        <p>I am a big fan of kettlebells, boxing, cycling and home workouts.</p>
        <ul>
          {lifting.slice(0, 3).map((post) => (
            <li>
              <a href={`/posts/${post.slug}`}>{post.data.title}</a> <span class="muted">· {formatDate(post.data.date)}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="card hobby-block">
        <Marker shape="tri">Numismatics</Marker>
        <p>
          Greek silver from the Archaic period onward, the Greco-Baktrian and Indo-Greek kings, and Roman imperial
          coinage.
        </p>
        <ul class="hobby-links">
          <li><a href="/hobbies/coins/collection">Numismatic cabinet</a> — every coin with its full catalogue entry</li>
          <li><a href="/hobbies/coins/board">The board</a> — all of them on one wall, hover to turn a coin over</li>
        </ul>
        <ul>
          {coins.slice(0, 3).map((post) => (
            <li>
              <a href={`/posts/${post.slug}`}>{post.data.title}</a> <span class="muted">· {formatDate(post.data.date)}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="card hobby-block">
        <Marker shape="ci">Reading</Marker>
        <p><a href="/hobbies/reading">Reading Shelf</a></p>
        <p><a href="/hobbies/reading/downloads">Downloadable PDFs</a></p>
      </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hobby-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .hobby-block {
    padding: 1.4rem 1.4rem 1.5rem;
  }

  .hobby-block ul {
    display: grid;
    gap: 0.45rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hobby-block li {
    position: relative;
    padding-left: 1.1rem;
  }

  .hobby-block li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 7px;
    background: var(--ink);
  }

  .hobby-links {
    color: var(--ink-3);
    font-size: 0.95rem;
  }
</style>
