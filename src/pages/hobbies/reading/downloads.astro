---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHead from "../../../components/PageHead.astro";
import Marker from "../../../components/Marker.astro";

const downloadColumns = [
  {
    section: "German",
    files: [
      {
        title: "Adjective Declension CheatSheet + Quiz",
        href: "/downloads/german/adjective-declension-cheatsheet-quiz-v2.pdf",
      },
      {
        title: "German Connectors and Nebensaetze",
        href: "/downloads/german/german-connectors-nebensaetze.pdf",
      },
      {
        title: "German Nebensatz + Adverb CheatSheet",
        href: "/downloads/german/german-nebensatz-adverb-cheatsheet.pdf",
      },
      {
        title: "Modal Verbs Complete Guide",
        href: "/downloads/german/modal-verbs-complete-guide.pdf",
      },
    ],
  },
  {
    section: "Stoic Quotes",
    files: [
      {
        title: "A Stoic a Day",
        href: "/downloads/stoic/a-stoic-a-day.pdf",
      },
    ],
  },
  {
    section: "Terminal Shortcuts",
    files: [
      {
        title: "Keyboard Shortcuts",
        href: "/downloads/terminal/keyboard-shortcuts.pdf",
      },
    ],
  },
];

// Each column takes the next shape in the set.
const MARKS = ["sq", "tri", "ci"] as const;
---

<BaseLayout
  title="Reading Downloads | Dogus Ural"
  description="Free cheat sheets: German grammar guides, a Stoic daily reader and terminal keyboard shortcuts."
>
  <section class="section">
    <div class="container">
      <PageHead title="PDF Library">
        <p>Cheat sheets and references. All links open in a new tab.</p>
        <p><a href="/hobbies/reading">← Back to reading shelf</a></p>
      </PageHead>

      <div class="pdf-columns">
        {downloadColumns.map((column, index) => (
          <section class="card pdf-col">
            <Marker shape={MARKS[index % MARKS.length]}>{column.section}</Marker>
            <ul class="pdf-list">
              {column.files.map((file) => (
                <li>
                  <a href={file.href} target="_blank" rel="noreferrer">
                    {file.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pdf-columns {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .pdf-col {
    padding: 1.4rem 1.4rem 1.5rem;
  }

  .pdf-list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pdf-list li {
    position: relative;
    padding-left: 1.1rem;
  }

  .pdf-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 7px;
    background: var(--red);
  }
</style>
