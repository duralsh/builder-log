---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, sortByDateDesc } from "../../lib/posts";

const posts = sortByDateDesc(
  await getCollection("posts", ({ data }) => !data.draft && data.tags.includes("lifting")),
);
---

<BaseLayout
  title="Lifting | Dogus Ural"
  description="Training log: kettlebells, boxing, cycling and barbell work, with milestones and programme notes."
>
  <section class="section">
    <div class="container">
      <h1>Lifting</h1>
      <p class="muted">
        Posts tagged <code>lifting</code>: milestones, training notes, and progress updates.
      </p>
      <div class="post-grid">
        {
          posts.map((post) => (
            <a class="card post-card" href={`/posts/${post.slug}`}>
              {post.data.cover && <img src={post.data.cover} alt={post.data.title} class="cover-img" loading="lazy" decoding="async" />}
              <div class="post-meta">
                <span class="pill">{formatDate(post.data.date)}</span>
              </div>
              <h2>{post.data.title}</h2>
              <p class="muted">{post.data.excerpt}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
