---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHead from "../components/PageHead.astro";
import Marker from "../components/Marker.astro";
import Shape from "../components/Shape.astro";
import { STOIC_QUOTES } from "../lib/stoicQuotes";
import { PERSON } from "../lib/person";

// Each tile carries a primary form where it used to carry an emoji, paired as
// the reference pairs them: blue circle, red square, yellow triangle.
const features = [
  {
    shape: "circle",
    color: "blue",
    eyebrow: "Work",
    title: "CV & experience",
    body: "From bare-metal firmware to fintech product leadership — now leading the AI transformation at AVILOO.",
    href: "/cv",
  },
  {
    shape: "square",
    color: "red",
    eyebrow: "Building",
    title: "Things I build",
    body: "AI tooling, agents, and workshops, plus the consumer crypto products that came before them.",
    href: "/projects",
  },
  {
    shape: "triangle",
    color: "yellow",
    eyebrow: "Numismatics",
    title: "Ancient coins",
    body: "A cabinet of Classical Greek tetradrachms and Roman silver denarii, catalogued by era.",
    href: "/hobbies/coins/collection",
  },
  {
    shape: "bar",
    color: "ink",
    eyebrow: "Training",
    title: "Lifting log",
    body: "Kettlebells, boxing, cycling, and home workouts — milestones and training notes.",
    href: "/hobbies/lifting",
  },
  {
    shape: "quarter",
    color: "red",
    eyebrow: "Reading",
    title: "Reading shelf",
    body: "Books I keep returning to, plus a small library of downloadable cheat sheets.",
    href: "/hobbies/reading",
  },
  {
    shape: "semi",
    color: "ink",
    eyebrow: "Writing",
    title: "All posts",
    body: "A chronological feed across work, lifting, and coins. Long-form notes and builder logs.",
    href: "/posts",
  },
] as const;
---

<BaseLayout
  title="Dogus Ural — Head of AI at AVILOO, Vienna"
  description="Head of AI at AVILOO. Engineering, fintech, and product background, now focused entirely on AI."
  jsonLd={PERSON}
>
  <section class="section">
    <div class="container">
      <PageHead title="Dogus Ural" sub="Head of AI · AVILOO" mark>
        <p class="place">Vienna, Austria</p>
      </PageHead>

      <div class="hero">
        <div class="hero-copy">
          <h2 class="hero-title">Building AI into how a company actually works.</h2>
          <p>
            I lead AI at <a href="https://aviloo.com/en" target="_blank" rel="noreferrer">AVILOO</a>, the global leader in
            independent EV battery diagnostics — the company-wide transformation, from internal enablement and agentic
            workflows to the data platform underneath. Before that, nearly a decade in engineering, fintech, and consumer
            product: Director of Product at
            <a href="https://arena.social/home" target="_blank" rel="noreferrer">Arena</a>, embedded software at Snap.
            Deep in Roman history, ancient coins, and things that grow on their own.
          </p>
          <div class="hero-buttons">
            <a class="btn btn-primary" href="/cv">View CV</a>
            <a class="btn btn-secondary" href="/projects">See what I build</a>
          </div>
        </div>
        <figure class="portrait">
          <img src="/dogus-hero.png" alt="Dogus Ural portrait" decoding="async" />
          <span class="portrait-shape"><Shape kind="triangle" color="yellow" /></span>
        </figure>
      </div>

      <section class="explore">
        <div class="explore-head">
          <Marker shape="tri">Explore</Marker>
          <p>A bit of everything I care about.</p>
        </div>
        <div class="tray">
          {
            features.map((feature) => (
              <a class="tile" href={feature.href}>
                <span class="tile-glyph">
                  <Shape kind={feature.shape} color={feature.color} />
                </span>
                <span class="tile-eyebrow">{feature.eyebrow}</span>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
                <span class="tile-open">Open →</span>
              </a>
            ))
          }
        </div>
      </section>

      <div class="closing">
        <section class="closing-block">
          <Marker shape="ci">Stoic quote of the day</Marker>
          <figure class="stoic">
            <span class="stoic-sun" aria-hidden="true"></span>
            <blockquote>
              <q id="stoic-quote">{STOIC_QUOTES[0].quote}</q>
            </blockquote>
            <figcaption>
              <span class="stoic-bar" aria-hidden="true"></span>
              <span id="stoic-author">{STOIC_QUOTES[0].author}</span>
            </figcaption>
          </figure>
        </section>

        <section class="closing-block">
          <Marker shape="sq">Contact</Marker>
          <div class="contact">
            <h3>Want to build something together?</h3>
            <p>I'm always happy to talk AI, product, ancient coins, or kettlebells.</p>
            <a class="btn btn-primary" href="mailto:dogusural@gmail.com">Get in touch</a>
          </div>
        </section>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ stoicQuotes: STOIC_QUOTES }}>
    const hashString = (value) => {
      let hash = 0;
      for (let i = 0; i < value.length; i++) {
        hash = (hash * 31 + value.charCodeAt(i)) >>> 0;
      }
      return hash;
    };
    const dateKeyLocal = (date) => {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, "0");
      const day = String(date.getDate()).padStart(2, "0");
      return `${year}-${month}-${day}`;
    };
    const quotes = Array.isArray(stoicQuotes) ? stoicQuotes : [];
    if (quotes.length > 0) {
      const today = new Date();
      const yesterday = new Date(today);
      yesterday.setDate(today.getDate() - 1);
      const todayKey = dateKeyLocal(today);
      const yesterdayKey = dateKeyLocal(yesterday);

      let index = hashString(todayKey) % quotes.length;
      const previousIndex = hashString(yesterdayKey) % quotes.length;
      if (quotes.length > 1 && index === previousIndex) {
        index = (index + 1) % quotes.length;
      }

      const selected = quotes[index];
      const quoteNode = document.getElementById("stoic-quote");
      const authorNode = document.getElementById("stoic-author");
      // The <q> element supplies the quote marks.
      if (quoteNode) quoteNode.textContent = selected.quote;
      if (authorNode) authorNode.textContent = selected.author;
    }
  </script>
</BaseLayout>

<style>
  .place {
    color: var(--ink);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: lowercase;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .hero-title {
    margin: 0 0 1.4rem;
    font-size: clamp(2.3rem, 4.8vw, 4.1rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .hero-copy p {
    max-width: 54ch;
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.9rem;
  }

  .portrait {
    position: relative;
    margin: 0;
  }

  .portrait img {
    display: block;
    width: 100%;
    aspect-ratio: 5 / 6;
    object-fit: cover;
    border: 2px solid var(--ink);
    box-shadow: 11px 11px 0 var(--ink);
    background: var(--cream);
  }

  .portrait-shape {
    position: absolute;
    top: -34px;
    right: -26px;
    width: clamp(64px, 7vw, 96px);
    transform: rotate(12deg);
  }

  .explore {
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .explore-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    margin-bottom: 1.4rem;
  }

  .explore-head .marker {
    margin: 0;
  }

  .explore-head p {
    margin: 0;
    color: var(--ink-3);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .tray {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .tile {
    display: flex;
    flex-direction: column;
    padding: 1.3rem 1.3rem 1.2rem;
    border: 2px solid var(--ink);
    background: var(--cream);
    color: var(--ink-2);
    text-decoration: none;
    transition: transform 0.35s var(--spring), box-shadow 0.35s var(--spring);
  }

  .tile:hover {
    transform: translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--ink);
    color: var(--ink-2);
  }

  .tile-glyph {
    display: block;
    width: 58px;
    margin-bottom: 1.6rem;
    transition: transform 0.45s var(--spring);
  }

  .tile:hover .tile-glyph {
    transform: rotate(-8deg) scale(1.06);
  }

  .tile-eyebrow {
    color: var(--ink-3);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: lowercase;
  }

  .tile h3 {
    margin: 0.35rem 0 0.5rem;
    font-size: 1.35rem;
  }

  .tile p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .tile-open {
    margin-top: auto;
    padding-top: 1.1rem;
    color: var(--ink);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }

  /* The two closing panels stand side by side at one height. */
  .closing {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
  }

  .closing-block {
    display: flex;
    flex-direction: column;
  }

  /* The quote as a poster: the deep, inward blue, a yellow sun cut off by the
     frame, and the author behind the same short bar the masthead uses. The
     blue is fixed rather than the lifted night blue, so cream text keeps its
     contrast in both themes. */
  .stoic {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.8rem;
    margin: 0;
    padding: clamp(1.6rem, 3.5vw, 2.4rem) clamp(6rem, 12vw, 10rem) clamp(1.6rem, 3.5vw, 2.2rem)
      clamp(1.6rem, 3.5vw, 2.4rem);
    overflow: hidden;
    border: 2px solid var(--ink);
    background: #1d4e9e;
    box-shadow: 11px 11px 0 var(--ink);
  }

  .stoic-sun {
    position: absolute;
    top: -4.5rem;
    right: -4.5rem;
    width: clamp(9rem, 15vw, 12.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--yellow);
  }

  .stoic blockquote {
    position: relative;
    margin: 0;
  }

  .stoic q {
    display: block;
    quotes: "\201E" "\201C";
    color: #f1ead8;
    font-size: clamp(1.45rem, 2.7vw, 2.15rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.015em;
  }

  .stoic q::before,
  .stoic q::after {
    color: var(--yellow);
  }

  .stoic figcaption {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #f1ead8;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: lowercase;
  }

  .stoic-bar {
    flex: none;
    width: 44px;
    height: 6px;
    background: var(--yellow);
  }

  .contact {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.4rem, 3vw, 2rem);
    border: 2px solid var(--ink);
    background: var(--cream);
    box-shadow: 11px 11px 0 var(--ink);
  }

  .contact h3 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
  }

  .contact p {
    margin: 0 0 1.3rem;
  }

  .contact .btn {
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .tray {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .closing {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }

    .portrait {
      max-width: 420px;
    }
  }

  @media (max-width: 760px) {
    .portrait img,
    .stoic,
    .contact {
      box-shadow: 7px 7px 0 var(--ink);
    }
  }

  @media (max-width: 600px) {
    .tray {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Too narrow to keep a column clear of the sun, so the quote starts
       below it and takes the full width. */
    .stoic {
      padding: 5rem 1.4rem 1.5rem;
    }

    .stoic-sun {
      top: -3.5rem;
      right: -3rem;
      width: 8rem;
    }
  }
</style>
