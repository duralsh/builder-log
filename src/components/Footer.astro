---
const year = new Date().getFullYear();

const columns = [
  {
    title: "Site",
    links: [
      { label: "Home", href: "/" },
      { label: "CV", href: "/cv" },
      { label: "Projects", href: "/projects" },
      { label: "All Posts", href: "/posts" },
    ],
  },
  {
    title: "Hobbies",
    links: [
      { label: "Lifting", href: "/hobbies/lifting" },
      { label: "Numismatics", href: "/hobbies/coins" },
      { label: "Reading", href: "/hobbies/reading" },
      { label: "Cabinet", href: "/hobbies/coins/collection" },
    ],
  },
  {
    title: "Elsewhere",
    links: [
      { label: "Email", href: "mailto:dogusural@gmail.com" },
      { label: "LinkedIn", href: "https://www.linkedin.com/in/dogus-ural" },
      { label: "GitHub", href: "https://github.com/duralsh" },
      { label: "X", href: "https://x.com/dural_sh" },
    ],
  },
];

// The CV told as five stages, from firmware to AI. Each stage starts at the
// role that opened it and covers the ones that followed it.
const milestones = [
  { year: "2016", stage: "Engineer", detail: "Firmware & telecom, Turkey" },
  { year: "2019", stage: "Embedded", detail: "Security & AR hardware, Vienna" },
  { year: "2022", stage: "Product", detail: "Concept to launch" },
  { year: "2024", stage: "Fintech", detail: "Director of Product, Arena" },
  { year: "2026", stage: "AI leadership", detail: "Head of AI, AVILOO" },
];
---

<footer>
  <div class="container foot">
    <ol class="timeline" aria-label="Career timeline">
      {
        milestones.map((m) => (
          <li>
            <b>{m.year}</b>
            <span class="stage">{m.stage}</span>
            <span class="detail">{m.detail}</span>
          </li>
        ))
      }
    </ol>

    <div class="footer-cols">
      {
        columns.map((col) => (
          <div class="footer-col">
            <h4>{col.title}</h4>
            <ul>
              {col.links.map((link) => {
                const external = link.href.startsWith("http") || link.href.startsWith("mailto");
                return (
                  <li>
                    <a href={link.href} target={external ? "_blank" : undefined} rel={external ? "noreferrer" : undefined}>
                      {link.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="fine">
      <span>Head of AI at AVILOO. Engineering, fintech, and product background, now all-in on AI. Vienna, Austria.</span>
      <span>© {year} Dogus Ural · Built with Astro</span>
    </p>
  </div>
</footer>

<style>
  footer {
    margin-top: auto;
  }

  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: end;
    gap: 2.2rem 4rem;
    padding: 1.4rem 0 2.2rem;
    border-top: 7px solid var(--ink);
  }

  .timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    margin: 0;
    padding: 18px 0 0;
    list-style: none;
  }

  /* The rail runs through the middle of the shapes. */
  .timeline::before {
    content: "";
    position: absolute;
    top: 24px;
    left: 6px;
    right: 6px;
    height: 2px;
    background: var(--ink);
  }

  .timeline li {
    position: relative;
    padding: 24px 0.8rem 0 0;
    line-height: 1.35;
    text-transform: lowercase;
  }

  .timeline li::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 14px;
    height: 14px;
    background: var(--ink);
  }

  .timeline li:nth-child(1)::before {
    background: var(--red);
  }

  .timeline li:nth-child(2)::before {
    background: var(--blue);
    border-radius: 50%;
  }

  .timeline li:nth-child(3)::before {
    background: var(--yellow);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  /* The line ends on the red dot that closes every page title: now. */
  .timeline li:nth-child(5)::before {
    background: var(--red);
    border-radius: 50%;
  }

  .timeline b {
    display: block;
    color: var(--ink);
    font-size: 22px;
    letter-spacing: -0.02em;
  }

  .stage {
    display: block;
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .detail {
    display: block;
    margin-top: 2px;
    color: var(--ink-3);
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .footer-col h4 {
    margin: 0 0 0.7rem;
    padding-bottom: 0.45rem;
    border-bottom: 2px solid var(--ink);
    font-size: 12px;
    letter-spacing: 0.14em;
  }

  .footer-col ul {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-col a {
    color: var(--ink-2);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: lowercase;
  }

  .footer-col a:hover {
    color: var(--red);
  }

  .fine {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    margin: 0;
    color: var(--ink-3);
    font-size: 11.5px;
    letter-spacing: 0.03em;
  }

  @media (max-width: 860px) {
    .foot {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Five stages will not fit across a phone, so the rail turns vertical. */
  @media (max-width: 560px) {
    .timeline {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.9rem;
      padding: 0 0 0 28px;
    }

    .timeline::before {
      top: 6px;
      bottom: 6px;
      left: 6px;
      right: auto;
      width: 2px;
      height: auto;
    }

    .timeline li {
      padding: 0;
    }

    .timeline li::before {
      top: 4px;
      left: -28px;
    }

    .timeline b {
      display: inline;
      margin-right: 0.5rem;
      font-size: 18px;
    }

    .stage {
      display: inline;
    }

    .footer-cols {
      gap: 1rem;
    }
  }
</style>
