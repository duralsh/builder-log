---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import { formatDate, sortByDateDesc } from "../../lib/posts";

const workshops = sortByDateDesc(
  await getCollection("posts", ({ data }) => !data.draft && data.tags.includes("workshop")),
).reverse(); // chronological: #1 first

// Each row's number sits on the next shape in the set.
const MARKS = ["sq", "tri", "ci", "se", "qu"] as const;
---

<BaseLayout
  title="AI Workshop Series | Projects | Dogus Ural"
  description="A hands-on internal workshop series I run teaching teams to work with Claude."
>
  <section class="section">
    <div class="container">
      <PageHead title="AI Workshop Series">
        <p>
          A recurring internal series I run to get a whole company working effectively with AI. Practical,
          no-jargon sessions that build from fundamentals up to custom skills and connecting Claude to real tools. Each
          session ships with a self-contained handout and a recording.
        </p>
      </PageHead>

      <ol class="ship-list">
        {workshops.map((post, index) => (
          <li class="card ship-row">
            <div class="ship-meta">
              <span class={`marker mk-${MARKS[index % MARKS.length]}`}><span class="num">{index + 1}</span></span>
              <span class="pill">{formatDate(post.data.date)}</span>
            </div>
            <div class="ship-main">
              <h2>
                <a href={`/posts/${post.slug}`}>{post.data.title}</a>
              </h2>
              <p>{post.data.excerpt}</p>
              <a class="read-link" href={`/posts/${post.slug}`}>Read the recap →</a>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .ship-list {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ship-row {
    display: grid;
    grid-template-columns: 11.5rem minmax(0, 1fr);
    gap: 0.8rem 1.6rem;
    padding: 1.5rem 1.6rem 1.6rem;
  }

  .ship-meta {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.9rem;
  }

  .ship-meta .marker {
    margin: 0;
  }

  .ship-main h2 {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.15;
  }

  .ship-main h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .ship-main h2 a:hover {
    color: var(--red);
  }

  .ship-main p {
    margin: 0.5rem 0 0;
    max-width: 74ch;
  }

  .read-link {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }

  @media (max-width: 760px) {
    .ship-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .ship-meta {
      grid-auto-flow: column;
      justify-content: start;
      align-items: end;
    }
  }
</style>
