---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "/", label: "Home" },
  { href: "/cv", label: "CV" },
  { href: "/projects", label: "Projects" },
  { href: "/hobbies", label: "Hobbies" },
  { href: "/posts", label: "All Posts" },
];

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header>
  <div class="container nav-shell">
    <a class="brand" href="/">
      Dogus Ural<span class="brand-dot" aria-hidden="true"></span>
    </a>
    <nav aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} class={pathname === link.href ? "active" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="nav-right">
      <ThemeToggle />
      <a class="btn btn-primary nav-cta" href="mailto:dogusural@gmail.com">Get in touch</a>
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--grain) var(--paper);
    background-blend-mode: var(--grain-blend);
    border-bottom: 2px solid var(--ink);
  }

  .nav-shell {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem 0;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    color: var(--ink);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    text-decoration: none;
    text-transform: lowercase;
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand-dot {
    width: 0.22em;
    height: 0.22em;
    margin-left: 0.05em;
    border-radius: 50%;
    background: var(--red);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.2rem 1.5rem;
  }

  nav a {
    position: relative;
    padding: 0.4rem 0;
    color: var(--ink-2);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: lowercase;
  }

  /* The pressed bar from the reference's swatches, under the current page. */
  nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 4px;
    background: var(--ink);
    transform: scaleX(0);
    transition: transform 0.4s var(--spring);
  }

  nav a:hover,
  nav a.active {
    color: var(--ink);
  }

  nav a:hover::after,
  nav a.active::after {
    transform: scaleX(1);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: end;
  }

  .nav-cta {
    min-height: 40px;
    padding: 0 1rem;
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .nav-shell {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "brand right"
        "nav nav";
    }

    .brand {
      grid-area: brand;
    }

    .nav-right {
      grid-area: right;
    }

    nav {
      grid-area: nav;
      justify-content: flex-start;
      column-gap: 1rem;
    }
  }
</style>
