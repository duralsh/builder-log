---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import Marker from "../../components/Marker.astro";
import Pictogram from "../../components/Pictogram.astro";
import { BOOKS } from "../../lib/books";
import { coinSlug, coins, ZOOMED } from "../../lib/coins";

// A hand-picked row, by slug. A coin that leaves the cabinet simply drops out
// of it rather than breaking the page.
const FEATURED = [
  "lysimachos-kalchedon-tetradrachm",
  "eumenes-i-philetairos-tetradrachm",
  "eukratides-i-tetradrachm-a",
  "alexander-iii-drachm-lifetime-sardes",
  "athens-tetradrachm-classical",
];
const sampleCoins = FEATURED.flatMap((slug) => coins.filter((coin) => coinSlug(coin) === slug));

const shelf = BOOKS.slice(0, 6);
---

<BaseLayout
  title="Hobbies | Dogus Ural"
  description="Dogus Ural's hobbies outside work: ancient coins, a reading shelf and lifting."
>
  <section class="section">
    <div class="container">
      <PageHead title="Hobbies">
        <p>Coins, books and lifting, outside work.</p>
      </PageHead>

      <div class="hobbies">
        <article class="card hobby">
          <Marker><Pictogram slot="icon" kind="coin" />Numismatics</Marker>
          <p class="hobby-line">Ancient coins, each with its full catalogue entry.</p>
          <ul class="coin-row">
            {
              sampleCoins.map((coin) => (
                <li>
                  <a
                    class="coin"
                    href={`/hobbies/coins/${coinSlug(coin)}`}
                    style={ZOOMED.has(coinSlug(coin)) ? "--z: 1.25" : undefined}
                  >
                    <span class="coin-window">
                      {/* Both faces sit side by side in one image, as on the
                          board, so sliding it by half turns the coin over. */}
                      <img
                        class="coin-face"
                        src={coin.image.replace(".webp", "-sm.webp")}
                        alt={`${coin.title}, ${coin.type}`}
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="linkouts">
            <a class="linkout" href="/hobbies/coins/collection">cabinet</a>
            <a class="linkout" href="/hobbies/coins/board">board</a>
          </div>
        </article>

        <article class="card hobby">
          <Marker><Pictogram slot="icon" kind="book" />Reading</Marker>
          <p class="hobby-line">Books I keep returning to, and cheat sheets to download.</p>
          <a class="cover-row" href="/hobbies/reading" aria-label="Reading shelf">
            {shelf.map((book) => <img src={book.cover} alt="" loading="lazy" decoding="async" />)}
          </a>
          <div class="linkouts">
            <a class="linkout" href="/hobbies/reading">shelf</a>
            <a class="linkout" href="/hobbies/reading/downloads">pdfs</a>
          </div>
        </article>

        <article class="card hobby">
          <Marker><Pictogram slot="icon" kind="kettlebell" />Lifting</Marker>
          <p class="hobby-line">I am a big fan of kettlebells, boxing, cycling and home workouts.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hobbies {
    display: grid;
    gap: 14px;
  }

  .hobby {
    padding: 1.4rem 1.6rem 1.5rem;
  }

  .hobby-line {
    margin: 0.7rem 0 0;
    max-width: 60ch;
  }

  .coin-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 1.3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .coin {
    display: block;
  }

  .coin-window {
    position: relative;
    display: block;
    width: clamp(64px, 11vw, 120px);
    aspect-ratio: 1;
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--cream);
    transition: transform 0.35s var(--spring), box-shadow 0.35s var(--spring);
  }

  .coin-face {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 200%;
    height: 100%;
    object-fit: cover;
    /* The board's sizing: --z enlarges a coin photographed small, and the
       shift keeps the visible face centred while it does. */
    transform: translateX(calc(25% * (var(--z, 1) - 1))) scale(var(--z, 1));
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .coin:hover .coin-face,
  .coin:focus-visible .coin-face {
    transform: translateX(calc(-25% * (var(--z, 1) + 1))) scale(var(--z, 1));
  }

  .coin:hover .coin-window,
  .coin:focus-visible .coin-window {
    transform: translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--ink);
  }

  .coin:focus-visible {
    outline: none;
  }

  .coin:focus-visible .coin-window {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .cover-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    width: fit-content;
    margin-top: 1.3rem;
  }

  .cover-row img {
    display: block;
    width: clamp(56px, 9vw, 100px);
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border: 2px solid var(--ink);
    background: var(--paper-deep);
    transition: transform 0.35s var(--spring), box-shadow 0.35s var(--spring);
  }

  .cover-row:hover img,
  .cover-row:focus-visible img {
    transform: translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--ink);
  }
</style>
