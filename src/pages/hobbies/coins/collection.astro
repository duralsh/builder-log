---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { geoConicEqualArea, geoGraticule, geoPath } from "d3-geo";
import { feature } from "topojson-client";
import landTopo from "world-atlas/land-50m.json";

import {
  coins,
  categories,
  categoryFor,
  coinSlug,
  issuerLink,
  parseStartYear,
  toToken,
  yearFor,
} from "../../../lib/coins";


// "AD 212" -> 212, "Circa 167-148 BC" -> -167, "Ca. 4th century BC" -> -400.
// Returns null when the string names no year, so callers can fall back.

// Anchor numbering is stateful, so it stays with the page rather than living
// in the shared module where two routes would share one counter.
const anchorCounts = new Map<string, number>();
const buildAnchor = (value: string) => {
  const base = toToken(value) || "item";
  const next = (anchorCounts.get(base) ?? 0) + 1;
  anchorCounts.set(base, next);
  return next === 1 ? base : `${base}-${next}`;
};

const groupedCoins = categories
  .map((category) => ({
    category,
    items: coins
      .filter((coin) => categoryFor(coin) === category)
      .sort((a, b) => yearFor(a) - yearFor(b)),
  }))
  .filter((group) => group.items.length > 0);

// Nothing may vanish. This page once shipped with 7 coins silently filtered out
// because their computed category was absent from the list above; a new coin that
// matches no rule must break the build, not disappear from the page.
const placedCount = groupedCoins.reduce((n, group) => n + group.items.length, 0);
if (placedCount !== coins.length) {
  throw new Error(
    `Cabinet: ${coins.length - placedCount} coin(s) fell outside every listed category (${placedCount}/${coins.length} placed).`,
  );
}
const uncategorised = coins.filter((coin) => categoryFor(coin) === "Other");
if (uncategorised.length > 0) {
  throw new Error(
    `Cabinet: no category rule matched: ${uncategorised.map((coin) => `"${coin.title}" (${coin.date})`).join("; ")}`,
  );
}

// ---------------------------------------------------------------------------
// Mint map. Everything below runs at build time, so the projection, the
// coastline and the marker positions are baked into the HTML as inline SVG —
// no mapping library reaches the browser.
// ---------------------------------------------------------------------------

type Mint = { label: string; lat: number; lon: number; region?: boolean; dx?: number; dy?: number };

const MINTS: Record<string, Mint> = {
  lugdunum: { label: "Lugdunum", lat: 45.76, lon: 4.83 },
  ticinum: { label: "Ticinum", lat: 45.19, lon: 9.16, dy: -10 },
  rome: { label: "Rome", lat: 41.89, lon: 12.49 },
  siscia: { label: "Siscia", lat: 45.49, lon: 16.37 },
  corinth: { label: "Corinth", lat: 37.94, lon: 22.93, dy: 12 },
  athens: { label: "Athens", lat: 37.98, lon: 23.73, dx: 8, dy: 8 },
  amphipolis: { label: "Amphipolis", lat: 40.82, lon: 23.84, dy: -10 },
  chersonesos: { label: "Chersonesos", lat: 40.30, lon: 26.40, dy: 14 },
  phokaia: { label: "Phokaia", lat: 38.67, lon: 26.76, dx: -6, dy: 10 },
  miletos: { label: "Miletos", lat: 37.53, lon: 27.28, dy: 12 },
  pergamon: { label: "Pergamon", lat: 39.12, lon: 27.18, dx: 6, dy: -8 },
  kyzikos: { label: "Kyzikos", lat: 40.39, lon: 27.89, dy: -12 },
  heraclea: { label: "Heraclea", lat: 40.97, lon: 27.95, dy: -22 },
  sardes: { label: "Sardes", lat: 38.49, lon: 28.04, dx: 10 },
  rhodes: { label: "Rhodes", lat: 36.44, lon: 28.22, dy: 14 },
  kalchedon: { label: "Kalchedon", lat: 40.98, lon: 29.03, dx: 14, dy: -10 },
  nicomedia: { label: "Nicomedia", lat: 40.77, lon: 29.92, dx: 16 },
  lycia: { label: "Lycia", lat: 36.30, lon: 29.80, region: true, dy: 14 },
  selge: { label: "Selge", lat: 37.23, lon: 31.13, dy: 12 },
  armenia: { label: "Cilician Armenia", lat: 37.45, lon: 35.82, region: true, dy: -12 },
  antioch: { label: "Antioch", lat: 36.20, lon: 36.16, dy: 14 },
  baktria: { label: "Bactria", lat: 36.76, lon: 66.90, region: true, dy: -12 },
  // Menander I ruled from Sagala (modern Sialkot); his realm ran from the Kabul
  // river east to the Ravi, with attested mints at Taxila and Alexandria-Kapisa.
  // Bactria proper is a separate centre ~800 km north-west, around Bactra.
  "indo-greek": { label: "Indo-Greek realm", lat: 32.49, lon: 74.53, region: true, dy: 14 },
};

// Mints that exist but cannot be placed; counted and reported, never dropped silently.
const UNLOCATABLE = new Set(["mint illegible"]);

const mintKey = (raw: string) => {
  const lower = raw.toLowerCase().trim();
  if (UNLOCATABLE.has(lower)) return null;
  // Region aliases are matched on the raw string, before the comma-stripping
  // below would reduce "Uncertain mint, Baktria" to "uncertain mint".
  if (lower.includes("baktria")) return "baktria";
  if (lower.includes("indo-greek")) return "indo-greek";
  const v = lower
    .replace(/\(.*?\)/g, " ")       // "Lugdunum (Lyons)" -> "Lugdunum"
    .replace(/,.*$/, " ")           // "Siscia, 4th officina" -> "Siscia"
    .replace(/\b\d+(st|nd|rd|th)\b/g, " ")
    .replace(/\bofficina\b/g, " ")
    .trim()
    .replace(/\s+/g, " ");
  if (v === "rhodos") return "rhodes";
  return v.replace(/\s+/g, "-");
};

type MintPin = {
  key: string; label: string; region: boolean; count: number;
  x: number; y: number; dx: number; dy: number;
  category: string; breakdown: string;
};

// Each coin's issuing authority linked to its Wikipedia article — the ruler for
// royal and imperial issues, the city or region for civic ones. Every slug below
// was checked against the Wikipedia API; a title with no entry simply renders
// unlinked, but a label that is not actually present in its title is a mapping
// bug and fails the build.

const mintCoins = new Map<string, (typeof coins)[number][]>();
for (const coin of coins) {
  const key = mintKey(coin.mint);
  // Coins whose mint cannot be read simply have no pin; they remain listed in
  // the cabinet below, so nothing is lost by leaving them off the map.
  if (key === null) continue;
  if (!MINTS[key]) {
    throw new Error(`Cabinet map: no coordinates for mint "${coin.mint}" (key "${key}") on "${coin.title}". Add it to MINTS.`);
  }
  const list = mintCoins.get(key) ?? [];
  list.push(coin);
  mintCoins.set(key, list);
}

const MAP_W = 1000;
const MAP_H = 520;
const MAP_PAD = 46;

const projection = geoConicEqualArea()
  .parallels([32, 46])
  .rotate([-38, 0])
  .fitExtent(
    [[MAP_PAD, MAP_PAD], [MAP_W - MAP_PAD, MAP_H - MAP_PAD]],
    { type: "MultiPoint", coordinates: [...mintCoins.keys()].map((k) => [MINTS[k].lon, MINTS[k].lat]) } as never,
  );
projection.clipExtent([[0, 0], [MAP_W, MAP_H]]);

const graticulePath = (geoPath(projection)(geoGraticule().step([10, 10])()) ?? "").replace(
  /\d+\.\d+/g,
  (n) => String(Math.round(Number(n) * 10) / 10),
);

const landFeature = feature(landTopo as never, (landTopo as never as { objects: { land: unknown } }).objects.land as never);
// Round to 1dp: the full-precision path is several times larger for no visible gain.
const landPath = (geoPath(projection)(landFeature as never) ?? "").replace(/\d+\.\d+/g, (n) => String(Math.round(Number(n) * 10) / 10));

const mintPins: MintPin[] = [...mintCoins.entries()]
  .map(([key, list]) => {
    const m = MINTS[key];
    const [x, y] = projection([m.lon, m.lat]) ?? [0, 0];
    const sorted = [...list].sort((a, b) => yearFor(a) - yearFor(b));
    const counts = new Map<string, number>();
    for (const c of list) counts.set(categoryFor(c), (counts.get(categoryFor(c)) ?? 0) + 1);
    return {
      key, label: m.label, region: Boolean(m.region), count: list.length,
      x: Math.round(x * 10) / 10, y: Math.round(y * 10) / 10,
      dx: m.dx ?? 0, dy: m.dy ?? 0,
      category: categoryFor(sorted[0]),
      breakdown: [...counts.entries()].map(([c, n]) => `${c}: ${n}`).join(" · "),
    };
  })
  .sort((a, b) => b.count - a.count);

// Uniform dots: size-by-count made the Aegean unreadable, and the count is in
// the tooltip anyway. At r=5 the closest two mints (10 units apart) no longer
// overlap at all.
const DOT_R = 5;

// A hit circle wider than the gap to the nearest mint swallows that mint's
// centre and steals its clicks — which is what made Kalchedon, Athens, Kyzikos
// and Pergamon unclickable. Cap every hit radius below that gap.
const nearestGap = (pin: MintPin) => {
  let best = Infinity;
  for (const other of mintPins) {
    if (other.key === pin.key) continue;
    best = Math.min(best, Math.hypot(pin.x - other.x, pin.y - other.y));
  }
  return best;
};
// One circle only steals another's click when it covers that circle's CENTRE,
// i.e. when the radius exceeds the gap — so 0.85 of the gap is both safe and
// noticeably easier to tap on a phone than half of it.
const hitRadiusFor = (pin: MintPin) => Math.max(7, Math.min(18, nearestGap(pin) * 0.85));
const categorySlug = (c: string) => toToken(c);

const groupedCoinsWithAnchors = groupedCoins.map((group) => ({
  ...group,
  anchor: buildAnchor(group.category),
  items: group.items.map((coin) => ({
    ...coin,
    anchor: buildAnchor(`${coin.title}-${coin.type}`),
    mintKey: mintKey(coin.mint) ?? "",
    wiki: issuerLink(coin.title),
    slug: coinSlug(coin),
  })),
}));

// Pills need a label that fits on one line; the section headings stay verbose.
const SHORT_LABEL: Record<string, string> = {
  "Classical & Hellenistic Greek": "Classical & Hellenistic",
};

const totalCoins = coins.length;
---

<BaseLayout title="Numismatic Cabinet | Dogus Ural">
  <section class="section">
    <div class="container">
      <h1>Numismatic Cabinet</h1>
      <p class="muted">
        {coins.length} coins, struck between the sixth century BC and the Abbasid caliphate — Archaic and Classical
        Greek silver, the Greco-Baktrian and Indo-Greek kings, and Roman imperial issues from Nerva to Constantine.
      </p>

      <p class="plate-link">
        <a href="/hobbies/coins/scale">See them at true scale →</a>
      </p>

      <figure class="mint-map">
        <div class="map-scroll">
        <svg viewBox={`0 0 ${MAP_W} ${MAP_H}`} role="img" aria-labelledby="mintmap-title mintmap-desc">
          <title id="mintmap-title">Where the cabinet was struck</title>
          <desc id="mintmap-desc">
            A map from Gaul to the Indus showing {mintPins.length} mints, sized by how many coins each struck.
          </desc>
          <defs>
            {/* Defined once and referenced twice — as the relief's clip and as
                the visible coastline — rather than repeating 44 KB of path. */}
            <path id="land-outline" d={landPath} />
            <clipPath id="land-clip">
              <use href="#land-outline" />
            </clipPath>
          </defs>
          <g class="map-viewport">
            <rect class="map-sea" x="0" y="0" width={MAP_W} height={MAP_H} />
            <path class="map-graticule" d={graticulePath} vector-effect="non-scaling-stroke" />
            {/* Natural Earth shaded relief, reprojected at build time to this
                exact projection, clipped to land so the sea stays flat. */}
            <image
              class="map-relief"
              href="/map/relief.webp"
              x="0"
              y="0"
              width={MAP_W}
              height={MAP_H}
              preserveAspectRatio="none"
              clip-path="url(#land-clip)"
            />
            <use href="#land-outline" class="map-land" vector-effect="non-scaling-stroke" />
          <g class="mint-layer">
            {mintPins.map((pin) => (
              /* Positioned on the outer group, sized on the inner one: the
                 inner group is counter-scaled against the zoom so markers hold
                 a constant screen size. Without that, zooming magnifies the
                 dots along with the map and the crowded Aegean never separates. */
              <g transform={`translate(${pin.x} ${pin.y})`}>
                <a
                  class="mint"
                  href={`#mint-${pin.key}`}
                  data-mint={pin.key}
                  aria-label={`${pin.label} — ${pin.count} coin${pin.count === 1 ? "" : "s"}`}
                >
                  <g class="mint-scale">
                    <title>{pin.label}{pin.region ? " (region)" : ""} — {pin.breakdown}</title>
                    <circle class="mint-hit" cx="0" cy="0" r={hitRadiusFor(pin)} />
                    <circle class={`mint-dot mint-dot--${categorySlug(pin.category)}`} cx="0" cy="0" r={DOT_R} />
                  </g>
                </a>
              </g>
            ))}
          </g>
          {/* Labels paint in their own layer so a neighbouring marker can never
              cover one — SVG has no z-index, only document order. */}
          <g class="label-layer" aria-hidden="true">
            {mintPins.map((pin) => (
              <g transform={`translate(${pin.x} ${pin.y})`}>
                <g class="mint-scale">
                  <text
                    class="mint-label"
                    data-mint={pin.key}
                    x={pin.dx}
                    y={pin.dy + (pin.dy < 0 ? -DOT_R - 3 : DOT_R + 11)}
                    text-anchor="middle"
                  >
                    {pin.label}
                  </text>
                </g>
              </g>
            ))}
          </g>
          </g>
        </svg>
        </div>
        <div class="map-controls">
          <button type="button" id="map-zoom-out" class="map-btn" aria-label="Zoom out" disabled>−</button>
          <button type="button" id="map-zoom-in" class="map-btn" aria-label="Zoom in">+</button>
          <button type="button" id="map-zoom-reset" class="map-btn map-btn--reset" hidden>Reset</button>
        </div>
        <figcaption>
          <span class="map-hint">Tap a mint to see only its coins. Zoom in to separate the crowded ones.</span>
        </figcaption>
      </figure>

      <nav class="period-nav" id="cabinet" aria-label="Filter by period">
        <a class="period is-active" href="#cabinet" data-period="all">
          All <span class="period-count">{totalCoins}</span>
        </a>
        {groupedCoinsWithAnchors.map((group) => (
          <a class="period" href={`#${group.anchor}`} data-period={group.anchor}>
            {SHORT_LABEL[group.category] ?? group.category} <span class="period-count">{group.items.length}</span>
          </a>
        ))}
        <span class="mint-chip" id="mint-chip" hidden>
          <span id="mint-chip-label"></span>
          <button type="button" id="mint-chip-clear" aria-label="Clear mint filter">×</button>
        </span>
      </nav>

      {groupedCoinsWithAnchors.map((group) => (
        <section class="coin-category" id={group.anchor} data-period={group.anchor}>
          <h2>
            {group.category} <span class="category-count">{group.items.length}</span>
          </h2>
          <details class="coin-index">
            <summary>Jump to a coin</summary>
            <ul>
              {group.items.map((coin) => (
                <li>
                  <a href={`#${coin.anchor}`}>
                    {coin.title} — {coin.type} <span class="muted">· {coin.date}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
          <ol class="coin-list">
            {group.items.map((coin) => (
              <li class="coin-item" id={coin.anchor} data-mint={coin.mintKey}>
                <h3>
                  {coin.wiki ? (
                    <>
                      {coin.wiki.before}
                      <a class="issuer" href={coin.wiki.url} target="_blank" rel="noreferrer">
                        {coin.wiki.label}
                      </a>
                      {coin.wiki.after}
                    </>
                  ) : (
                    coin.title
                  )}{" "}
                  - {coin.type}
                </h3>
                <p class="muted">
                  {coin.date} · {coin.mint}
                </p>
                <img
                  src={coin.image}
                  srcset={`${coin.image.replace(".webp", "-sm.webp")} 760w, ${coin.image} 1520w`}
                  sizes="(max-width: 820px) 100vw, 760px"
                  alt={`${coin.title} ${coin.type}`}
                  class="coin-image"
                  width={coin.width}
                  height={coin.height}
                  loading="lazy"
                  decoding="async"
                />
                <p>
                  <strong>Obv:</strong> {coin.obv}
                </p>
                <p>
                  <strong>Rev:</strong> {coin.rev}
                </p>
                <p>
                  <strong>References:</strong> {coin.refs}
                </p>
                {coin.notes ? (
                  <p>
                    <strong>Notes:</strong> {coin.notes}
                  </p>
                ) : null}
                {coin.condition ? (
                  <p>
                    <strong>Condition:</strong> {coin.condition}
                  </p>
                ) : null}
                {coin.weight || coin.diameter ? (
                  <p>
                    <strong>Weight:</strong> {coin.weight} · <strong>Diameter:</strong> {coin.diameter}
                    {coin.axis ? (
                      <>
                        {" "}
                        · <strong>Axis:</strong> {coin.axis}
                      </>
                    ) : null}
                  </p>
                ) : null}
                <p class="permalink">
                  <a href={`/hobbies/coins/${coin.slug}`}>Open this coin →</a>
                </p>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </section>

  <script is:inline>
    (() => {
      const nav = document.querySelector(".period-nav");
      if (!nav) return;

      const header = document.querySelector("header");
      const headerHeight = () => (header ? header.offsetHeight : 0);

      // The header wraps to two rows under 900px, so measure rather than guess.
      const syncOffset = () =>
        document.documentElement.style.setProperty("--header-h", `${headerHeight()}px`);
      syncOffset();
      window.addEventListener("resize", syncOffset);

      const pills = [...nav.querySelectorAll(".period")];
      const sections = [...document.querySelectorAll(".coin-category")];

      const apply = (requested) => {
        const known = requested === "all" || sections.some((s) => s.dataset.period === requested);
        const period = known ? requested : "all";

        for (const section of sections) {
          section.hidden = period !== "all" && section.dataset.period !== period;
        }
        for (const pill of pills) {
          const active = pill.dataset.period === period;
          pill.classList.toggle("is-active", active);
          if (active) pill.setAttribute("aria-current", "true");
          else pill.removeAttribute("aria-current");
        }
        return period;
      };

      for (const pill of pills) {
        pill.addEventListener("click", (event) => {
          event.preventDefault();
          const period = apply(pill.dataset.period);

          history.replaceState(
            null,
            "",
            period === "all" ? location.pathname + location.search : `#${period}`,
          );

          // Sections above the selection just disappeared, so the old scroll
          // position no longer means anything. Land on the first visible group.
          const first = sections.find((section) => !section.hidden);
          if (!first) return;
          const top = first.getBoundingClientRect().top + window.scrollY - headerHeight() - nav.offsetHeight - 12;
          window.scrollTo({ top: Math.max(0, top) });
        });
      }

      const isCategory = (value) => sections.some((section) => section.dataset.period === value);
      const fromHash = () => decodeURIComponent(location.hash.slice(1));

      const svgEl = document.querySelector(".mint-map svg");

      // --- pan & zoom ------------------------------------------------------
      // Hand-rolled rather than pulling in d3-zoom: this is the whole feature
      // in a few dozen lines, and the page still ships no mapping library.
      // Everything inside .map-viewport scales together, so marker spacing and
      // hit areas stay in proportion and clicks cannot start colliding.
      const viewport = document.querySelector(".map-viewport");
      const figure = document.querySelector(".mint-map");
      const MIN_K = 1;
      // The relief carries ~2000px across this extent, so it softens past ~2x.
      // 6x is well beyond what is needed to separate the Aegean cluster (mints
      // 9.6 units apart become ~70px apart on a desktop display) and keeps the
      // terrain reading as soft shading rather than obvious pixels.
      const MAX_K = 6;
      let k = 1;
      let tx = 0;
      let ty = 0;

      const svgSize = () => {
        const r = svgEl.getBoundingClientRect();
        return { w: r.width, h: r.height, left: r.left, top: r.top };
      };

      // Keep the map covering its frame: never let panning expose empty space.
      const clamp = () => {
        const { w, h } = svgSize();
        const maxX = 0;
        const minX = w - w * k;
        const maxY = 0;
        const minY = h - h * k;
        tx = Math.min(maxX, Math.max(minX, tx));
        ty = Math.min(maxY, Math.max(minY, ty));
      };

      let syncZoomButtons = () => {};
      const applyTransform = () => {
        clamp();
        const { w } = svgSize();
        const unit = w / 1000; // px per viewBox unit at k = 1
        viewport.setAttribute("transform", `translate(${tx / unit} ${ty / unit}) scale(${k})`);
        svgEl.style.setProperty("--k", String(k));
        figure.classList.toggle("is-zoomed", k > 1);
        syncZoomButtons();
      };

      const zoomAt = (clientX, clientY, factor) => {
        const { left, top } = svgSize();
        const px = clientX - left;
        const py = clientY - top;
        const next = Math.min(MAX_K, Math.max(MIN_K, k * factor));
        if (next === k) return;
        // hold the point under the cursor fixed
        tx = px - (px - tx) * (next / k);
        ty = py - (py - ty) * (next / k);
        k = next;
        if (k === MIN_K) { tx = 0; ty = 0; }
        applyTransform();
      };

      // Buttons rather than the wheel: scrolling the page with the cursor over
      // the map used to zoom it instead, which is the surprising part.
      const zoomCentre = (factor) => {
        const { w, h, left, top } = svgSize();
        zoomAt(left + w / 2, top + h / 2, factor);
      };
      const zoomInBtn = document.getElementById("map-zoom-in");
      const zoomOutBtn = document.getElementById("map-zoom-out");
      const zoomResetBtn = document.getElementById("map-zoom-reset");
      syncZoomButtons = () => {
        if (zoomInBtn) zoomInBtn.disabled = k >= MAX_K - 0.001;
        if (zoomOutBtn) zoomOutBtn.disabled = k <= MIN_K + 0.001;
        if (zoomResetBtn) zoomResetBtn.hidden = k <= MIN_K + 0.001;
      };
      zoomInBtn?.addEventListener("click", () => zoomCentre(1.6));
      zoomOutBtn?.addEventListener("click", () => zoomCentre(1 / 1.6));
      zoomResetBtn?.addEventListener("click", () => {
        k = MIN_K;
        tx = 0;
        ty = 0;
        applyTransform();
      });

      const pointers = new Map();
      let pinchStart = null;

      svgEl.addEventListener("pointerdown", (event) => {
        pointers.set(event.pointerId, event);
        if (pointers.size === 2) {
          const [a, b] = [...pointers.values()];
          pinchStart = { dist: Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY), k };
        }
      });

      svgEl.addEventListener("pointermove", (event) => {
        if (!pointers.has(event.pointerId)) return;
        const prev = pointers.get(event.pointerId);
        pointers.set(event.pointerId, event);

        if (pointers.size === 2 && pinchStart) {
          const [a, b] = [...pointers.values()];
          const dist = Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
          const factor = (dist / pinchStart.dist) * (pinchStart.k / k);
          zoomAt((a.clientX + b.clientX) / 2, (a.clientY + b.clientY) / 2, factor);
          return;
        }
        if (pointers.size === 1 && k > 1) {
          event.preventDefault();
          figure.classList.add("is-panning");
          tx += event.clientX - prev.clientX;
          ty += event.clientY - prev.clientY;
          applyTransform();
        }
      });

      const endPointer = (event) => {
        pointers.delete(event.pointerId);
        if (pointers.size < 2) pinchStart = null;
        if (pointers.size === 0) figure.classList.remove("is-panning");
      };
      svgEl.addEventListener("pointerup", endPointer);
      svgEl.addEventListener("pointercancel", endPointer);
      svgEl.addEventListener("pointerleave", endPointer);

      window.addEventListener("resize", applyTransform);

      // --- mint filter -----------------------------------------------------
      // Period and mint are alternative lenses on the same shelf, never
      // combined: intersecting them would strand the reader on an empty page.
      const pins = [...document.querySelectorAll(".mint")];
      const labels = [...document.querySelectorAll(".mint-label")];
      const items = [...document.querySelectorAll(".coin-item")];
      const chip = document.getElementById("mint-chip");
      const chipLabel = document.getElementById("mint-chip-label");
      const chipClear = document.getElementById("mint-chip-clear");
      const isMint = (value) => pins.some((pin) => pin.dataset.mint === value);

      const clearMint = () => {
        for (const item of items) item.hidden = false;
        for (const pin of pins) pin.classList.remove("is-active");
        for (const label of labels) label.classList.remove("is-active");
        if (chip) { chip.hidden = true; chip.classList.remove("is-shown"); }
        for (const section of sections) section.hidden = false;
      };

      const applyMint = (key) => {
        apply("all");                       // drop any period selection first
        let shown = 0;
        for (const item of items) {
          const match = item.dataset.mint === key;
          item.hidden = !match;
          if (match) shown += 1;
        }
        // a section with nothing left in it should go too, heading and all
        for (const section of sections) {
          section.hidden = [...section.querySelectorAll(".coin-item")].every((i) => i.hidden);
        }
        for (const pin of pins) pin.classList.toggle("is-active", pin.dataset.mint === key);
        for (const label of labels) label.classList.toggle("is-active", label.dataset.mint === key);
        const active = pins.find((pin) => pin.dataset.mint === key);
        if (chip && chipLabel && active) {
          chipLabel.textContent = `${active.getAttribute("aria-label")}`;
          chip.hidden = false;
          chip.classList.add("is-shown");
        }
        return shown;
      };

      // The label layer is a sibling of the marker layer, not a child, so CSS
      // cannot reach from a hovered marker to its label — wire it up here.
      const labelFor = (key) => labels.find((label) => label.dataset.mint === key);
      for (const pin of pins) {
        const label = labelFor(pin.dataset.mint);
        if (label) {
          const show = () => label.classList.add("is-hovered");
          const hide = () => label.classList.remove("is-hovered");
          pin.addEventListener("mouseenter", show);
          pin.addEventListener("mouseleave", hide);
          pin.addEventListener("focus", show);
          pin.addEventListener("blur", hide);
        }
      }

      for (const pin of pins) {
        pin.addEventListener("click", (event) => {
          event.preventDefault();
          const key = pin.dataset.mint;
          const already = pin.classList.contains("is-active");
          if (already) {
            clearMint();
            history.replaceState(null, "", location.pathname + location.search);
            return;
          }
          applyMint(key);
          history.replaceState(null, "", `#mint-${key}`);
          const first = sections.find((section) => !section.hidden);
          if (!first) return;
          const top = first.getBoundingClientRect().top + window.scrollY - headerHeight() - nav.offsetHeight - 12;
          window.scrollTo({ top: Math.max(0, top) });
        });
      }

      if (chipClear) {
        chipClear.addEventListener("click", () => {
          clearMint();
          history.replaceState(null, "", location.pathname + location.search);
        });
      }

      // choosing a period must drop the mint lens
      for (const pill of pills) {
        pill.addEventListener("click", () => clearMint(), true);
      }

      // A category hash filters; a coin hash leaves everything shown so the
      // browser's own anchor jump still lands on it.
      const initial = fromHash();
      if (initial.startsWith("mint-") && isMint(initial.slice(5))) applyMint(initial.slice(5));
      else if (initial) apply(initial);

      // Back/forward and hand-edited hashes. Guarded on isCategory so that
      // clicking a coin link doesn't silently reset the active filter.
      window.addEventListener("hashchange", () => {
        const next = fromHash();
        if (next.startsWith("mint-") && isMint(next.slice(5))) applyMint(next.slice(5));
        else if (isCategory(next)) { clearMint(); apply(next); }
      });
    })();
  </script>
</BaseLayout>

