---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "/", label: "Home" },
  { href: "/cv", label: "CV" },
  { href: "/projects", label: "Projects" },
  { href: "/hobbies", label: "Hobbies" },
  { href: "/posts", label: "All Posts" },
];

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header>
  <div class="container nav-shell">
    <a class="brand" href="/">
      <span class="brand-dot" aria-hidden="true"></span>
      Dogus Ural
    </a>
    <nav aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} class={pathname === link.href ? "active" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="nav-right">
      <ThemeToggle />
      <a class="btn btn-primary nav-cta" href="mailto:dogusural@gmail.com">Get in touch</a>
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--canvas) 88%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--hairline);
  }

  .nav-shell {
    display: grid;
    gap: 0.9rem;
    padding: 0.85rem 0;
    align-items: center;
    grid-template-columns: auto 1fr auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-size: 1.05rem;
    text-decoration: none;
  }

  .brand-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--brand-pink);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-pink) 22%, transparent);
  }

  nav {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  nav a {
    color: var(--muted);
    padding: 0.35rem 0.7rem;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--rounded-pill);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  nav a.active {
    color: var(--ink);
    background: var(--surface-card);
  }

  nav a:hover {
    color: var(--ink);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: end;
  }

  @media (max-width: 900px) {
    .nav-shell {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "brand right"
        "nav nav";
    }

    .brand {
      grid-area: brand;
    }

    .nav-right {
      grid-area: right;
    }

    nav {
      grid-area: nav;
      justify-content: flex-start;
      margin-left: -0.7rem;
    }
  }
</style>
