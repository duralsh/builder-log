---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import { formatDate, sortByDateDesc } from "../../lib/posts";

const posts = sortByDateDesc(await getCollection("posts", ({ data }) => !data.draft && data.tags.includes("coins")));
---

<BaseLayout
  title="Numismatics | Dogus Ural"
  description="Numismatics notes by Dogus Ural: Greek silver, the Greco-Baktrian and Indo-Greek kings, and Roman imperial coinage."
>
  <section class="section">
    <div class="container">
      <PageHead title="Numismatics">
        <p>
          Greek silver from the Archaic period onward, the Greco-Baktrian and Indo-Greek kings, and Roman imperial
          coinage.
        </p>
      </PageHead>
      <div class="post-grid">
        {
          posts.map((post) => (
            <a class="card post-card" href={`/posts/${post.slug}`}>
              {post.data.cover && <img src={post.data.cover} alt={post.data.title} class="cover-img" loading="lazy" decoding="async" />}
              <div class="post-meta">
                <span class="pill">{formatDate(post.data.date)}</span>
              </div>
              <h2>{post.data.title}</h2>
              <p class="muted">{post.data.excerpt}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
