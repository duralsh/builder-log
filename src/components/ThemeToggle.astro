<button id="theme-toggle" type="button" aria-label="Toggle light and dark theme" title="Toggle theme">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle class="ring" cx="12" cy="12" r="8" />
    <path class="half" d="M12 4a8 8 0 0 1 0 16Z" />
  </svg>
</button>

<style>
  #theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 2px solid var(--ink);
    background: var(--cream);
    color: var(--ink);
    cursor: pointer;
    transition: transform 0.35s var(--spring), box-shadow 0.35s var(--spring);
  }

  #theme-toggle:hover {
    transform: translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--ink);
  }

  svg {
    width: 20px;
    height: 20px;
    transition: transform 0.5s var(--spring);
  }

  .ring {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
  }

  .half {
    fill: var(--ink);
  }

  /* Night turns the filled half to the other side. */
  :global(:root[data-theme="dark"]) svg {
    transform: rotate(180deg);
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById("theme-toggle");
  btn?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    localStorage.setItem("site-theme", next);
  });
</script>
