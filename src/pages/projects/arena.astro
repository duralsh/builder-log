---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";

const shippedItems = [
  {
    title: "Arena Staking + Arena Champions",
    summary:
      "Built staking for Arena's native token and launched Arena Champions, where the top 500 stakers participate in company revenue share.",
    metric: "Top 500 + rev-share",
    visual: "/arena/arena-champions-leaderboard.png",
  },
  {
    title: "Activity Feed for Live In-App Events",
    summary:
      "Designed a dedicated in-app feed that surfaces key actions in real time: token trades, perpetual position opens, new joins, and Arena staking events.",
    metric: "Live feed",
    visual: "/covers/work-wallets.svg",
    gif: "/arena/activity-feed.gif",
  },
  {
    title: "Livestreaming + Voice Calls with Tipping",
    summary:
      "Shipped livestreaming and voice-call rooms similar to Twitter Spaces, where users can tip the host and speakers directly inside the live chat.",
    metric: "Live + tipping",
    visual: "/arena/livestream-voice-tipping.png",
  },
  {
    title: "Perpetual DEX + HIP-3 Market Expansion",
    summary:
      "Integrated Hyperliquid to support perpetual DEX trading across 200+ crypto markets, and added HIP-3 for commodity and stock exposure, all seamlessly inside Arena.",
    metric: "200+ markets",
    visual: "/covers/work-perps.svg",
    gif: "/arena/perps-hip3.gif",
  },
  {
    title: "Multichain Wallet + Native Swaps + Social Layer",
    summary:
      "Shipped a multichain wallet with native swaps and integrated social features, bringing asset actions and social engagement into one seamless flow.",
    metric: "Wallet + swaps",
    visual: "/covers/work-wallets.svg",
    gif: "/arena/arena-champions-trimmed.gif",
  },
];
---

<BaseLayout
  title="Arena | Projects | Dogus Ural"
  description="Build log from Arena, a SocialFi platform: embedded wallets, perpetual trading via Hyperliquid, staking and an in-app agent economy."
>
  <section class="section">
    <div class="container">
      <PageHead title="Arena">
        <p>Selected product launches and platform capabilities.</p>
      </PageHead>

      <ul class="ship-list">
        {shippedItems.map((item) => (
          <li class="card ship-row">
            <div class="ship-meta">
              <span class="pill">{item.metric}</span>
            </div>
            <div class="ship-main">
              <h2>{item.title}</h2>
              <p>{item.summary}</p>
              {item.gif ? (
                <img
                  src={item.gif}
                  alt={`${item.title} animated preview`}
                  class="ship-visual"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <img src={item.visual} alt={item.title} class="ship-visual" loading="lazy" decoding="async" />
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .ship-list {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The meta column is sized for the longest metric tag, which then never
     breaks mid-phrase. */
  .ship-row {
    display: grid;
    grid-template-columns: 11.5rem minmax(0, 1fr);
    gap: 0.8rem 1.6rem;
    padding: 1.5rem 1.6rem 1.6rem;
  }

  .ship-meta {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.9rem;
  }

  .ship-meta .pill {
    white-space: nowrap;
  }

  .ship-main h2 {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.15;
  }

  .ship-main p {
    margin: 0.5rem 0 0;
    max-width: 74ch;
  }

  /* Most of these are phone recordings about twice as tall as wide; capping
     the height keeps each launch to a screen instead of a 1,300px strip. */
  .ship-visual {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 34rem;
    margin-top: 1rem;
    border: 2px solid var(--ink);
    box-shadow: 7px 7px 0 var(--ink);
    background: var(--paper-deep);
  }

  @media (max-width: 760px) {
    .ship-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .ship-meta {
      grid-auto-flow: column;
      justify-content: start;
      align-items: end;
    }

    .ship-visual {
      box-shadow: 5px 5px 0 var(--ink);
    }
  }
</style>
