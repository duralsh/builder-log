---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, sortByDateDesc } from "../lib/posts";

const projects = sortByDateDesc(
  await getCollection("posts", ({ data }) => !data.draft && data.tags.includes("project")),
);

const projectEmoji: Record<string, string> = {
  praegen: "🧠",
  "ai-workshops": "🤖",
  "git-commit-ai": "🤖",
  arena: "⚔️",
  "builder-log": "🧱",
  "hyperliquid-copy-trader": "📈",
};

// Projects with an actual logo image (shown instead of the emoji).
const projectLogo: Record<string, string> = {
  praegen: "/covers/praegen-mark.png",
};

const internalProjectRoutes: Record<string, { href: string; label: string }> = {
  arena: { href: "/projects/arena", label: "Build log" },
  "ai-workshops": { href: "/projects/ai-workshops", label: "Workshops" },
};

// Inline brand/utility marks (FontAwesome free paths, currentColor fill).
const ICONS: Record<string, string> = {
  web: '<svg viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M352 256c0 22.2-1.2 43.6-3.3 64H163.3c-2.2-20.4-3.3-41.8-3.3-64s1.2-43.6 3.3-64H348.7c2.2 20.4 3.3 41.8 3.3 64zm28.8-64H503.9c5.3 20.5 8.1 41.9 8.1 64s-2.8 43.5-8.1 64H380.8c2.1-20.6 3.2-42 3.2-64s-1.1-43.4-3.2-64zm112.6-32H376.7c-10-63.9-29.8-117.4-55.3-151.6 78.3 20.7 142 77.5 171.9 151.6zm-149.1 0H167.7c6.1-36.4 15.5-68.6 27-94.7 10.5-23.6 22.2-40.7 33.5-51.5C249 1.7 256 0 256 0s7 1.7 20.9 13.8c11.3 10.8 23 27.9 33.5 51.5 11.6 26 20.9 58.2 27 94.7zm-209 0H18.6C48.6 85.9 112.2 29.1 190.6 8.4 165.1 42.6 145.3 96.1 135.3 160zM8.1 192H131.2c-2.1 20.6-3.2 42-3.2 64s1.1 43.4 3.2 64H8.1C2.8 299.5 0 278.1 0 256s2.8-43.5 8.1-64zM194 480.6c-11.6-26-20.9-58.2-27-94.6H344.3c-6.1 36.4-15.5 68.6-27 94.6-10.5 23.6-22.2 40.7-33.5 51.5C270 510.3 263 512 256 512s-14-1.7-20.9-13.8c-11.3-10.8-23-27.9-33.5-51.5zM135.3 352c10 63.9 29.8 117.4 55.3 151.6C112.2 482.9 48.6 426.1 18.6 352h116.7zm358.1 0c-30 74.1-93.6 130.9-171.9 151.6 25.5-34.2 45.3-87.7 55.3-151.6h116.6z"/></svg>',
  appstore:
    '<svg viewBox="0 0 384 512" fill="currentColor" aria-hidden="true"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>',
  googleplay:
    '<svg viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z"/></svg>',
  github:
    '<svg viewBox="0 0 496 512" fill="currentColor" aria-hidden="true"><path d="M165.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3 .3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6zm-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5 .3-6.2 2.3zm44.2-1.7c-2.9 .7-4.9 2.6-4.6 4.9 .3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9zM244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.3-14.3-112.3-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252 496 113.3 383.5 8 244.8 8z"/></svg>',
  log: '<svg viewBox="0 0 384 512" fill="currentColor" aria-hidden="true"><path d="M0 64C0 28.7 28.7 0 64 0H224V128c0 17.7 14.3 32 32 32H384V448c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V64zm384 64H256V0L384 128z"/></svg>',
};

const iconForLabel = (label: string) => {
  const l = label.toLowerCase();
  if (l.includes("app store")) return "appstore";
  if (l.includes("google play")) return "googleplay";
  return "web";
};

type Chip = { href: string; icon: string; label: string; external: boolean };

const chipsFor = (project: (typeof projects)[number]): Chip[] => {
  const chips: Chip[] = [];
  const liveLink = project.data.links?.find((l) => l.label === "Live");
  const internalRoute = internalProjectRoutes[project.slug];

  if (liveLink) chips.push({ href: liveLink.url, icon: "web", label: "Web app", external: true });
  for (const l of project.data.links ?? []) {
    if (l.label === "Live") continue;
    chips.push({ href: l.url, icon: iconForLabel(l.label), label: l.label, external: true });
  }
  if (internalRoute) chips.push({ href: internalRoute.href, icon: "log", label: internalRoute.label, external: false });
  if (project.data.github) chips.push({ href: project.data.github, icon: "github", label: "Code", external: true });

  return chips;
};
---

<BaseLayout title="Projects | Dogus Ural">
  <section class="section">
    <div class="container">
      <h1>🛠️ Things I Build</h1>
      <ul class="project-list">
        {
          projects.map((project) => (
            <li class="project-item">
              <div class="project-head">
                {projectLogo[project.slug] ? (
                  <img class="project-logo" src={projectLogo[project.slug]} alt={`${project.data.title} logo`} loading="lazy" decoding="async" />
                ) : (
                  <span class="emoji">{projectEmoji[project.slug] ?? "🛠️"}</span>
                )}
                <span class="project-title">{project.data.title}</span>
                <span class="pill date-pill">{formatDate(project.data.date)}</span>
              </div>
              <p class="muted excerpt">{project.data.excerpt}</p>
              <div class="linkouts">
                {chipsFor(project).map((chip) => (
                  <a
                    class="linkout"
                    href={chip.href}
                    target={chip.external ? "_blank" : undefined}
                    rel={chip.external ? "noreferrer" : undefined}
                  >
                    <span class="linkout-icon" set:html={ICONS[chip.icon]} />
                    {chip.label}
                  </a>
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .project-list {
    list-style: none;
    margin: 1.8rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }

  .project-item {
    background: var(--surface-card);
    border-radius: var(--rounded-lg);
    padding: 1.4rem 1.6rem;
  }

  .project-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .emoji {
    font-size: 1.15rem;
  }

  .project-logo {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
  }

  .project-title {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 1.2rem;
    color: var(--ink);
  }

  .date-pill {
    margin-left: auto;
    background: var(--canvas);
  }

  .excerpt {
    margin: 0.6rem 0 0;
    max-width: 70ch;
  }

  .linkouts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.1rem;
  }

  .linkout {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--rounded-pill);
    border: 1px solid var(--hairline);
    background: var(--canvas);
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.12s ease;
  }

  .linkout:hover {
    border-color: var(--ink);
    transform: translateY(-1px);
    color: var(--ink);
  }

  .linkout-icon {
    display: inline-flex;
    width: 15px;
    height: 15px;
  }

  .linkout-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 560px) {
    .date-pill {
      margin-left: 0;
    }
  }
</style>
