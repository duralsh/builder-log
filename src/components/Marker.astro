---
// A section heading in the reference's voice: a primary shape, then a bold
// label. A tone overrides the shape's own colour where the colour carries
// meaning. Extra props (including the parent's scoping attribute) land on the
// root.
interface Props {
  shape?: "sq" | "tri" | "ci" | "se" | "qu";
  tone?: "yellow" | "blue" | "red" | "ink" | "ring" | "ring-red";
  as?: "h2" | "h3";
  id?: string;
  class?: string;
}

const { shape = "sq", tone, as: Tag = "h2", class: className, ...rest } = Astro.props;
---

<Tag class:list={["marker", `mk-${shape}`, tone && `tone-${tone}`, className]} {...rest}>
  <span class="mk-shape" aria-hidden="true"></span><span class="lbl"><slot /></span>
</Tag>
