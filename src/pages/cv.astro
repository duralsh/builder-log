---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHead from "../components/PageHead.astro";
import Marker from "../components/Marker.astro";
import { sortByDateDesc } from "../lib/posts";
import { PERSON } from "../lib/person";

const allPosts = sortByDateDesc(await getCollection("posts", ({ data }) => !data.draft && data.tags.includes("work")));

const roles = [
  {
    title: "Head of AI",
    company: "AVILOO GmbH",
    location: "Wiener Neudorf / Vienna",
    start: new Date("2026-04-26"),
    end: null,
    dates: "Apr 2026 – Present",
    description:
      "AVILOO is the global leader in independent battery diagnostics for electric vehicles — manufacturer-independent tests that read battery health down to the individual cell, used by OEM dealer networks, fleets, leasing operators, and remarketing platforms across more than 30 countries. I lead the company-wide AI transformation.",
    links: [{ label: "aviloo.com", url: "https://aviloo.com/en" }],
    bullets: [
      "Own AVILOO’s AI strategy and roadmap end to end — from where AI belongs in the business to what actually ships",
      "Drive internal AI enablement across engineering, operations, and go-to-market: agentic workflows, internal tooling, and the training and adoption work that makes them stick",
      "Built AI-powered strategy dashboards that turn operational and battery-diagnostic data into decisions leadership can act on",
      "Moved company localisation onto agentic workflows — content now ships in 28 languages without a manual translation loop",
      "Building the AI platform underneath it all: data pipelines, model serving, evaluation harnesses, and governance",
      "Run a recurring internal workshop series that takes whole teams from LLM fundamentals to writing custom skills and wiring models into real tools via MCP",
    ],
  },
  {
    title: "Director of Product",
    company: "Arena Inc.",
    location: "Vienna / New York",
    start: new Date("2024-02-01"),
    end: new Date("2026-04-26"),
    dates: "Feb 2024 – Apr 2026",
    description:
      "Arena is a SocialFi platform combining embedded wallets, perpetual trading, token launches, and social features.",
    links: [
      { label: "arena.social", url: "https://arena.social/home" },
      { label: "arenatrade.ai", url: "https://arenatrade.ai" },
    ],
    bullets: [
      "Enabled AI agents across the social platform and designed an agent economy layer within the social app",
      "Led a team of 12 engineers and 3 designers",
      "Integrated perpetuals trading via Hyperliquid; $100M volume in first month",
      "DEX reached $500M cumulative volume since May 2025",
      "Scaled platform from ~2k to ~16k DAU",
      "Shipped embedded wallets (EVM + Solana), account abstraction, cross-chain protocols",
      "Social login to wallet provisioning (Twitter, Apple, Google, Facebook, TikTok)",
      "Launched platform token with staking and revenue sharing; ~$200M FDV peak",
    ],
  },
  {
    title: "Product & Engineering Lead",
    company: "Ural e.U.",
    location: "Vienna",
    start: new Date("2022-05-01"),
    end: new Date("2024-02-01"),
    dates: "May 2022 – Feb 2024",
    description:
      "Consumer NFT and gaming launches on Avalanche and Starknet. Managed 3 engineers, 2 designers, 4 artists. Products: OOPA, FlipBlob, Platypus. Concept to launch across UX, smart-contract integration, and release operations.",
    links: [],
    bullets: [],
  },
  {
    title: "Software Engineer (AR / Embedded)",
    company: "Snap Inc.",
    location: "Vienna",
    start: new Date("2021-03-01"),
    end: new Date("2022-05-01"),
    dates: "Mar 2021 – May 2022",
    description:
      "Embedded software for Snap smart glasses. Built userspace libraries interfacing with Android and custom Linux sensor drivers. Collaborated across hardware, firmware, and product design.",
    links: [{ label: "spectacles.com", url: "https://www.spectacles.com/" }],
    bullets: [],
  },
  {
    title: "Embedded Software Team Lead",
    company: "Riddle&Code",
    location: "Vienna",
    start: new Date("2019-01-01"),
    end: new Date("2021-01-01"),
    dates: "Jan 2019 – Jan 2021",
    description:
      "Led embedded and security projects across automotive, logistics, energy, and fintech. Owned delivery planning, customer communication, and task breakdowns.",
    links: [
      {
        label: "Wien Energie x RIDDLE&CODE",
        url: "https://www.businesswire.com/news/home/20211214005937/en/Wien-Energie-and-RIDDLECODE-Extend-Their-Partnership-to-Support-and-Accelerate-Global-Decarbonisation-Efforts",
      },
      {
        label: "CoinDesk - Daimler crypto hardware wallet",
        url: "http://coindesk.com/markets/2019/07/22/daimler-to-produce-crypto-hard-wallet-for-automotive-industry",
      },
    ],
    bullets: [],
  },
  {
    title: "Software Engineer",
    company: "Airties",
    location: "Istanbul",
    start: new Date("2018-08-01"),
    end: new Date("2019-01-01"),
    dates: "Aug 2018 – Jan 2019",
    description: "Core software for telecom customers. Triaged and fixed production issues.",
    links: [],
    bullets: [],
  },
  {
    title: "Embedded Software Engineer",
    company: "Accenture",
    location: "Istanbul",
    start: new Date("2017-07-01"),
    end: new Date("2018-08-01"),
    dates: "Jul 2017 – Aug 2018",
    description: "Embedded components across multiple client projects. Istanbul.",
    links: [],
    bullets: [],
  },
  {
    title: "Embedded Software Engineer",
    company: "Volrad",
    location: "Ankara",
    start: new Date("2016-11-01"),
    end: new Date("2017-06-30"),
    dates: "Nov 2016 – Jun 2017",
    description: "Firmware and peripheral drivers on bare-metal PIC microcontrollers. Ankara.",
    links: [],
    bullets: [],
  },
];

const rolePosts = (start: Date, end: Date | null) =>
  allPosts.filter((post) => post.data.date >= start && (end ? post.data.date < end : true));
---

<BaseLayout
  title="CV — Dogus Ural, Head of AI at AVILOO"
  description="Dogus Ural's CV. Head of AI at AVILOO in Vienna, leading the company-wide AI transformation. Previously Director of Product at Arena and embedded software engineer at Snap."
  jsonLd={PERSON}
>
  <section class="section">
    <div class="container">
      <PageHead title="CV">
        <p>
          Nearly a decade across embedded engineering, fintech, and consumer product — now focused entirely on AI. I lead
          the AI transformation at AVILOO, the global leader in independent EV battery diagnostics.
        </p>
      </PageHead>

      <section class="cv-work">
        <Marker n={1} shape="sq">Experience</Marker>
        <div class="cv-list">
          {
            roles.map((role) => (
              <article class="card role">
                <div class="role-when">
                  <span class="role-dates">{role.dates}</span>
                  <span class="role-location">{role.location}</span>
                </div>
                <div class="role-body">
                  <h2>
                    {role.title} — {role.company}
                  </h2>
                  {role.links.length > 0 && (
                    <div class="role-links">
                      <span>Links:</span>
                      {role.links.map((link) => (
                        <a href={link.url} target="_blank" rel="noreferrer">
                          {link.label}
                        </a>
                      ))}
                    </div>
                  )}
                  <p>{role.description}</p>

                  {role.bullets.length > 0 && (
                    <ul class="ticks">
                      {role.bullets.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  )}

                  {rolePosts(role.start, role.end).length > 0 && (
                    <div class="related-posts">
                      <h3>Related posts</h3>
                      <ul>
                        {rolePosts(role.start, role.end).map((post) => (
                          <li>
                            <a href={`/posts/${post.slug}`}>{post.data.title}</a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <div class="cv-meta">
        <section>
          <Marker n={2} shape="ci">Education</Marker>
          <ul class="ticks">
            <li>M.S. Computer Science — METU, Ankara · 2016–2017</li>
            <li>B.S. Electronics Engineering — Ankara University · 2008–2015</li>
          </ul>
        </section>
        <section class="skills">
          <Marker n={3} shape="tri">Skills</Marker>
          <p>
            <strong>AI:</strong> AI strategy and transformation, agentic workflows, LLM application design, prompt and
            context engineering, evals and benchmarking, MCP and tool integration, model routing and cost control,
            org-wide AI enablement and training
          </p>
          <p>
            <strong>AI platform &amp; data:</strong> data pipelines, model serving, evaluation harnesses, analytics and
            strategy dashboards, observability, governance
          </p>
          <p>
            <strong>Product:</strong> strategy, roadmaps, discovery, execution, growth loops, stakeholder management, user
            research, launch planning, competitive analysis
          </p>
          <p>
            <strong>Crypto / Fintech:</strong> non-custodial wallets (EOA, MPC, AA), cross-chain protocols, DeFi
            integrations, DEX/swaps, Layer 2, on/off-ramps, token design, social trading
          </p>
          <p>
            <strong>Technical:</strong> Solidity, Rust, Python, C/C++, Cairo, smart-contract integration, API design,
            embedded systems
          </p>
          <p><strong>Blockchain:</strong> EVM chains, Solana, Avalanche, Starknet, Base, Arbitrum, BNB</p>
          <p><strong>Languages:</strong> Turkish (native), English (fluent), German (intermediate)</p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cv-work {
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .cv-list {
    display: grid;
    gap: 14px;
  }

  .role {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 0.8rem 2rem;
    padding: 1.5rem 1.6rem 1.6rem;
  }

  .role-when {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding-top: 0.35rem;
  }

  .role-dates,
  .role-location {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }

  .role-dates {
    color: var(--ink);
  }

  .role-location {
    color: var(--ink-3);
  }

  .role h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
  }

  .role-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.9rem;
    color: var(--ink-3);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }

  .role-links a {
    padding: 0.15rem 0.55rem;
    border: 1.5px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.35s var(--spring), box-shadow 0.35s var(--spring);
  }

  .role-links a:hover {
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 var(--ink);
    color: var(--ink);
  }

  .ticks,
  .related-posts ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ticks li {
    position: relative;
    padding-left: 1.2rem;
  }

  /* Small red squares in place of bullets. */
  .ticks li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    background: var(--red);
  }

  .related-posts {
    margin-top: 1.2rem;
    padding-top: 0.9rem;
    border-top: 2px solid var(--ink);
  }

  .related-posts h3 {
    margin: 0 0 0.5rem;
    font-size: 12px;
    letter-spacing: 0.14em;
  }

  .cv-meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 5vw, 4rem);
  }

  .skills p {
    margin: 0 0 0.8rem;
  }

  @media (max-width: 760px) {
    .role {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }

    /* Dates and place share a line when they fit and wrap whole when not,
       rather than each breaking mid-phrase. */
    .role-when {
      display: flex;
      flex-wrap: wrap;
      gap: 0.2rem 1rem;
      padding-top: 0;
    }

    .role-dates,
    .role-location {
      white-space: nowrap;
    }

    .cv-meta {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
