---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import Marker from "../../components/Marker.astro";
import { BOOKS } from "../../lib/books";
---

<BaseLayout
  title="Reading | Dogus Ural"
  description="Books Dogus Ural returns to, on Stoicism, Rome, economics and product, plus downloadable cheat sheets."
>
  <section class="section">
    <div class="container">
      <PageHead title="Reading Shelf">
        <p>Icon view of books I keep returning to.</p>
      </PageHead>

      <section>
        <Marker shape="ci">Books</Marker>
        <ul class="book-grid">
          {BOOKS.map((book) => (
            <li class="book-item">
              <img src={book.cover} alt={`Cover of ${book.title}`} class="book-cover" loading="lazy" decoding="async" />
              <h3>{book.title}</h3>
              <p class="muted">{book.author}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .book-grid {
    display: grid;
    gap: 1.6rem 1.1rem;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .book-cover {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border: 2px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
    background: var(--paper-deep);
  }

  .book-item h3 {
    margin: 0.9rem 0 0.2rem;
    font-size: 0.95rem;
    line-height: 1.25;
  }

  .book-item p {
    margin: 0;
    font-size: 0.82rem;
  }
</style>
