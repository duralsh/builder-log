---
// Small pictograms for headings where an abstract form says too little: a
// kettlebell for lifting, a coin with a beaded rim for numismatics, an open
// book for reading. Built from the same primaries as the rest of the site.
interface Props {
  kind: "kettlebell" | "coin" | "book";
}

const { kind } = Astro.props;

// The dotted border struck round the edge of many ancient coins.
const BEADS = Array.from({ length: 12 }, (_, i) => {
  const a = (i * Math.PI) / 6;
  return { x: (16 + 10.2 * Math.cos(a)).toFixed(2), y: (16 + 10.2 * Math.sin(a)).toFixed(2) };
});
---

<svg class="pictogram" viewBox="0 0 32 32" aria-hidden="true">
  {
    kind === "kettlebell" && (
      <>
        {/* A flat grip on curved horns and a flat base: a round arch over a
            coloured body reads as a padlock instead. */}
        <path class="p-handle" d="M8 15C5.5 7 8 3.5 12 3.5H20C24 3.5 26.5 7 24 15" />
        <path class="p-ink" d="M11.53 29.5A10.5 10.5 0 1 1 20.47 29.5Z" />
      </>
    )
  }
  {
    kind === "coin" && (
      <>
        <circle class="p-coin" cx="16" cy="16" r="14" />
        {BEADS.map((b) => (
          <circle class="p-ink" cx={b.x} cy={b.y} r="1.3" />
        ))}
      </>
    )
  }
  {
    kind === "book" && (
      <>
        <path class="p-blue" d="M1.5 7l13 2.5V28l-13-2.5Z" />
        <path class="p-blue" d="M30.5 7l-13 2.5V28l13-2.5Z" />
      </>
    )
  }
</svg>

<style>
  .pictogram {
    display: block;
    flex: none;
    width: 28px;
    height: 28px;
    overflow: visible;
  }

  .p-handle {
    fill: none;
    stroke: var(--ink);
    stroke-width: 3.2;
    stroke-linejoin: round;
  }

  .p-coin {
    fill: var(--yellow);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .p-ink {
    fill: var(--ink);
  }

  .p-blue {
    fill: var(--blue);
  }
</style>
