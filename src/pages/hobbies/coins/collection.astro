    title: "ATTICA, Athens",
    type: "Tetradrachm",
    date: "Circa 454-404 BC",
    mint: "Athens",
    obv: "Head of Athena right, wearing crested Attic helmet ornamented with three olive leaves above visor and spiral palmette on bowl, round earring and pearl necklace.",
    rev: "Owl standing right, head facing; olive sprig and crescent behind, AΘE before; all within incuse square.",
    refs: "Kroll 8; HGC 4, 1597.",
    notes: "Ex Numismatik Naumann, Auction 159 (8 December 2025), lot 152.",
    condition: "Not specified",
    weight: "Not specified",
    diameter: "Not specified",
    axis: "",
    image: "/coins/athens-tetradrachm-owl.png",
    width: 800,
    height: 438,
  },
  {
    title: "ANTONINUS PIUS with MARCUS AURELIUS as Caesar",
    type: "Denarius",
    date: "AD 139-161",
    mint: "Rome",
    obv: "ANTONINVS AVG PIVS P P, laureate head of Antoninus Pius right.",
    rev: "AVRELIVS CAESAR AVG PII F COS II, bare head of Marcus Aurelius right.",
    refs: "Cf. RIC III 417a; RSC 15.",
    notes: "Ex Numismatik Naumann, Auction 159 (8 December 2025), lot 704.",
    condition: "Not specified",
    weight: "Not specified",
    diameter: "Not specified",
    axis: "",
    image: "/coins/antoninus-pius-marcus-aurelius-denarius.png",
    width: 800,
    height: 401,
  },
];

// "AD 212" -> 212, "Circa 167-148 BC" -> -167, "Ca. 4th century BC" -> -400.
// Returns null when the string names no year, so callers can fall back.
const parseStartYear = (value: string) => {
  const bc = /BC/i.test(value);
  const century = value.match(/(\d{1,2})(?:st|nd|rd|th)\b/i);
  if (century) {
    const n = Number(century[1]);
    return bc ? -(n * 100) : (n - 1) * 100 + 1;
  }
  const matches = [...value.matchAll(/\d{2,4}/g)].map((m) => Number(m[0]));
  if (matches.length === 0) return null;
  return bc ? -matches[0] : matches[0];
};

// A few entries date the coin only in prose ("Roman Imperial period",
// "Travel Series issue"); those carry the reign years in the title instead.
const yearFor = (coin: (typeof coins)[number]) => parseStartYear(coin.date) ?? parseStartYear(coin.title) ?? 0;

const toToken = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const anchorCounts = new Map<string, number>();
const buildAnchor = (value: string) => {
  const base = toToken(value) || "item";
  const next = (anchorCounts.get(base) ?? 0) + 1;
  anchorCounts.set(base, next);
  return next === 1 ? base : `${base}-${next}`;
};

const categoryFor = (coin: (typeof coins)[number]) => {
  if (/ARMENIA|Levon/i.test(coin.title)) return "Medieval";
  const year = yearFor(coin);
  if (year >= 1) return "Roman Imperial";
  if (year <= -500) return "Archaic Greek";
  if (year < 0) return "Classical & Hellenistic Greek";
  return "Other";
};

const categories = [
  "Archaic Greek",
  "Classical & Hellenistic Greek",
  "Roman Imperial",
  "Medieval",
  "Other",
] as const;

const groupedCoins = categories
  .map((category) => ({
    category,
    items: coins
      .filter((coin) => categoryFor(coin) === category)
      .sort((a, b) => yearFor(a) - yearFor(b)),
  }))
  .filter((group) => group.items.length > 0);

const groupedCoinsWithAnchors = groupedCoins.map((group) => ({
  ...group,
  anchor: buildAnchor(group.category),
  items: group.items.map((coin) => ({
    ...coin,
    anchor: buildAnchor(`${coin.title}-${coin.type}`),
  })),
}));

// Pills need a label that fits on one line; the section headings stay verbose.
const SHORT_LABEL: Record<string, string> = {
  "Classical & Hellenistic Greek": "Classical & Hellenistic",
};

const totalCoins = coins.length;
---

<BaseLayout title="Numismatic Cabinet | Dogus Ural">
  <section class="section">
    <div class="container">
      <h1>Numismatic Cabinet</h1>
      <p class="muted">A curated cabinet focused on Classical Greek tetradrachms and Roman Republic silver denarii.</p>

      <nav class="period-nav" id="cabinet" aria-label="Filter by period">
        <a class="period is-active" href="#cabinet" data-period="all">
          All <span class="period-count">{totalCoins}</span>
        </a>
        {groupedCoinsWithAnchors.map((group) => (
          <a class="period" href={`#${group.anchor}`} data-period={group.anchor}>
            {SHORT_LABEL[group.category] ?? group.category} <span class="period-count">{group.items.length}</span>
          </a>
        ))}
      </nav>

      {groupedCoinsWithAnchors.map((group) => (
        <section class="coin-category" id={group.anchor} data-period={group.anchor}>
          <h2>
            {group.category} <span class="category-count">{group.items.length}</span>
          </h2>
          <details class="coin-index">
            <summary>Jump to a coin</summary>
            <ul>
              {group.items.map((coin) => (
                <li>
                  <a href={`#${coin.anchor}`}>
                    {coin.title} — {coin.type} <span class="muted">· {coin.date}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
          <ol class="coin-list">
            {group.items.map((coin) => (
              <li class="coin-item" id={coin.anchor}>
                <h3>
                  {coin.title} - {coin.type}
                </h3>
                <p class="muted">
                  {coin.date} · {coin.mint}
                </p>
                <img
                  src={coin.image}
                  alt={`${coin.title} ${coin.type}`}
                  class="coin-image"
                  width={coin.width}
                  height={coin.height}
                  loading="lazy"
                  decoding="async"
                />
                <p>
                  <strong>Obv:</strong> {coin.obv}
                </p>
                <p>
                  <strong>Rev:</strong> {coin.rev}
                </p>
                <p>
                  <strong>References:</strong> {coin.refs}
                </p>
                {coin.notes ? (
                  <p>
                    <strong>Notes:</strong> {coin.notes}
                  </p>
                ) : null}
                <p>
                  <strong>Condition:</strong> {coin.condition}
                </p>
                <p>
                  <strong>Weight:</strong> {coin.weight} · <strong>Diameter:</strong> {coin.diameter}
                  {coin.axis ? (
                    <>
                      {" "}
                      · <strong>Axis:</strong> {coin.axis}
                    </>
                  ) : null}
                </p>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </section>

  <script is:inline>
    (() => {
      const nav = document.querySelector(".period-nav");
      if (!nav) return;

      const header = document.querySelector("header");
      const headerHeight = () => (header ? header.offsetHeight : 0);

      // The header wraps to two rows under 900px, so measure rather than guess.
      const syncOffset = () =>
        document.documentElement.style.setProperty("--header-h", `${headerHeight()}px`);
      syncOffset();
      window.addEventListener("resize", syncOffset);

      const pills = [...nav.querySelectorAll(".period")];
      const sections = [...document.querySelectorAll(".coin-category")];

      const apply = (requested) => {
        const known = requested === "all" || sections.some((s) => s.dataset.period === requested);
        const period = known ? requested : "all";

        for (const section of sections) {
          section.hidden = period !== "all" && section.dataset.period !== period;
        }
        for (const pill of pills) {
          const active = pill.dataset.period === period;
          pill.classList.toggle("is-active", active);
          if (active) pill.setAttribute("aria-current", "true");
          else pill.removeAttribute("aria-current");
        }
        return period;
      };

      for (const pill of pills) {
        pill.addEventListener("click", (event) => {
          event.preventDefault();
          const period = apply(pill.dataset.period);

          history.replaceState(
            null,
            "",
            period === "all" ? location.pathname + location.search : `#${period}`,
          );

          // Sections above the selection just disappeared, so the old scroll
          // position no longer means anything. Land on the first visible group.
          const first = sections.find((section) => !section.hidden);
          if (!first) return;
          const top = first.getBoundingClientRect().top + window.scrollY - headerHeight() - nav.offsetHeight - 12;
          window.scrollTo({ top: Math.max(0, top) });
        });
      }

      const isCategory = (value) => sections.some((section) => section.dataset.period === value);
      const fromHash = () => decodeURIComponent(location.hash.slice(1));

      // A category hash filters; a coin hash leaves everything shown so the
      // browser's own anchor jump still lands on it.
      const initial = fromHash();
      if (initial) apply(initial);

      // Back/forward and hand-edited hashes. Guarded on isCategory so that
      // clicking a coin link doesn't silently reset the active filter.
      window.addEventListener("hashchange", () => {
        const next = fromHash();
        if (isCategory(next)) apply(next);
      });
    })();
  </script>
</BaseLayout>

<style>
  /* Period filter bar. Sticks below the site header; --header-h is measured
     at runtime because the header wraps to two rows on narrow screens. */
  .period-nav {
    position: sticky;
    top: var(--header-h, 72px);
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.4rem -0.5rem 1.8rem;
    padding: 0.6rem 0.5rem;
    background: color-mix(in srgb, var(--canvas) 92%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--hairline);
    scroll-margin-top: 6.5rem;
  }

  .period {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--hairline);
    border-radius: var(--rounded-pill);
    background: var(--surface-card);
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .period:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .period.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--canvas);
  }

  .period-count {
    font-variant-numeric: tabular-nums;
    font-size: 0.75rem;
    opacity: 0.65;
  }

  .category-count {
    display: inline-block;
    margin-left: 0.35rem;
    padding: 0.1rem 0.5rem;
    border-radius: var(--rounded-pill);
    background: var(--surface-card);
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    vertical-align: middle;
  }

  /* Collapsed by default so 18 links don't push the coins off-screen. */
  .coin-index {
    margin: 0 0 1.2rem;
    border: 1px solid var(--hairline);
    border-radius: var(--rounded-md);
    background: var(--surface-card);
  }

  .coin-index summary {
    padding: 0.55rem 0.9rem;
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--muted);
    list-style: none;
  }

  .coin-index summary::-webkit-details-marker {
    display: none;
  }

  .coin-index summary::before {
    content: "▸";
    display: inline-block;
    margin-right: 0.5rem;
    transition: transform 0.15s ease;
  }

  .coin-index[open] summary::before {
    transform: rotate(90deg);
  }

  .coin-index summary:hover {
    color: var(--ink);
  }

  .coin-index ul {
    margin: 0;
    padding: 0 0.9rem 0.8rem 1.9rem;
    display: grid;
    gap: 0.4rem;
    list-style: none;
  }

  .coin-index a {
    font-size: 0.87rem;
    color: var(--body);
    text-decoration: none;
  }

  .coin-index a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .coin-category[hidden] {
    display: none;
  }

  .coin-category {
    margin-top: 1.3rem;
    scroll-margin-top: 6.5rem;
  }

  .coin-category h2 {
    margin-bottom: 0.55rem;
  }

  .coin-list {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 1.4rem;
  }

  .coin-item {
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 1.6rem;
    margin-bottom: 0.35rem;
    scroll-margin-top: 6.5rem;
  }

  .coin-item p:last-child {
    margin-bottom: 0.15rem;
  }

  .coin-image {
    width: min(760px, 100%);
    height: auto;
    display: block;
    border: 1px solid var(--hairline);
    border-radius: var(--rounded-md);
    background: var(--surface-soft);
    margin: 0.7rem 0 0.9rem;
  }

  @media (max-width: 720px) {
    /* Wrapping to three rows costs ~126px of a small viewport on top of an
       already-tall wrapped header, so scroll the pills sideways instead. */
    .period-nav {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      gap: 0.35rem;
      margin-bottom: 1.4rem;
      scroll-padding-left: 0.5rem;
      overscroll-behavior-x: contain;
    }

    .period-nav::-webkit-scrollbar {
      display: none;
    }

    .period {
      padding: 0.3rem 0.65rem;
      font-size: 0.8rem;
    }
  }

  /* The bar's own sticky offset is enough; don't double it on the sections. */
  @media (prefers-reduced-motion: reduce) {
    .period,
    .coin-index summary::before {
      transition: none;
    }
  }
</style>
