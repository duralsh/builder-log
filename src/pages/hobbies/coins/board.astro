---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { coins, categories, categoryFor, coinSlug, yearFor, type Coin } from "../../../lib/coins";

// Titles are catalogue headings, too long for a tile. Most shorten by rule;
// three are irregular enough that an override is clearer than more regex.
const SHORT_NAME: Record<string, string> = {
  "DYNASTS of LYCIA, uncertain": "LYCIA",
  "SELEUCIS AND PIERIA, Antioch. Philip I 'the Arab' (244-249)": "PHILIP I",
  "KINGS OF THRACE, Kalchedon, in the name of Lysimachos (305-281 BC)": "LYSIMACHOS",
};

const shortName = (title: string) => {
  if (SHORT_NAME[title]) return SHORT_NAME[title];
  let t = title
    .replace(/\s*\([^)]*\)/g, "") // (171-145 BC)
    .replace(/\s*'[^']*'/g, "") // 'the Great'
    .replace(/\s+(with|in the name of)\s+.*$/i, "")
    .replace(/^(KINGS? OF|KINGDOM OF|DYNASTS OF|ISLANDS OFF)\s+[A-Z]+,\s*/i, "");
  const parts = t.split(",").map((p) => p.trim()).filter(Boolean);
  return (parts[parts.length - 1] ?? t).replace(/\./g, "").trim().toUpperCase();
};

// Sixteen of these were composited here with the coin at 78% of an 840px tile
// inside 50px of padding, which leaves it filling only ~71% of its half. The
// auction photographs are cropped far tighter, so these need a nudge to sit at
// the same size on the board. The two Eukratides I obols are cut out rather
// than composited; they are framed to land at the same size under the same
// nudge. Listed by slug rather than by category, so a Baktrian coin bought at
// auction later is not zoomed by mistake.
const ZOOMED = new Set([
  "sophytes-drachm", "sophytes-obol",
  "euthydemos-i-tetradrachm-a", "euthydemos-ii-tetradrachm", "euthydemos-ii-obol",
  "eukratides-i-tetradrachm-a", "eukratides-i-drachm", "eukratides-ii-tetradrachm",
  "demetrios-i-obol", "heliokles-i-tetradrachm", "antimachos-i-obol",
  "menander-i-drachm-helmeted", "menander-i-drachm-a", "menander-i-drachm-b",
  "abbasid-dirham-a", "abbasid-dirham-b",
  "eukratides-i-obol-a", "eukratides-i-obol-b",
]);

// Twelve names repeat — five Constantines alone — so each tile carries a
// second line that actually tells them apart.
const subtitle = (coin: Coin) => [coin.type, coin.mint].filter(Boolean).join(" · ");

// The type field carries the metal as well as the denomination, and not in a
// fixed place: "AR Tetradrachm", "BI Tetradrachm" and "Tetradrachm AR" are all
// tetradrachms, and a follis arrives as "Follis (Bronze)", "Æ Follis" and
// "Silvered Æ Follis". Keying on the raw string would split each of those, so
// drop the metal and key on what is left. Nothing is lost: the subtitle under
// each tile still prints the type in full, which is what tells the billon
// tetradrachm from the silver ones once they sit together.
const METAL = /^(AR|AE|Æ|AV|BI|Silvered)$/i;

const denomination = (type: string) =>
  type
    .replace(/\s*\([^)]*\)/g, "") // (Bronze)
    .split(/\s+/)
    .filter((word) => word && !METAL.test(word))
    .join(" ") || type;

// Periods stay the headings; within one, like denominations are pulled next to
// each other. Sorting by year first and then bucketing keeps "oldest first"
// true twice over: a Map holds insertion order, so each run of a denomination
// appears where its earliest coin fell, and inside a run they stay in date
// order. Only the clustering is new -- the reading order is still the old one.
const cluster = (items: Coin[]) => {
  const runs = new Map<string, Coin[]>();
  for (const coin of items) {
    const key = denomination(coin.type);
    runs.set(key, [...(runs.get(key) ?? []), coin]);
  }
  return [...runs.values()].flat();
};

const groups = categories
  .map((category) => ({
    category,
    items: cluster(
      coins.filter((coin) => categoryFor(coin) === category).sort((a, b) => yearFor(a) - yearFor(b)),
    ),
  }))
  .filter((g) => g.items.length > 0);
---

<BaseLayout
  title="Coin Board — Dogus Ural"
  description="Every coin in the cabinet on one board, by period, with like denominations together. Hover a coin to turn it over."
>
  <section class="section">
    <div class="container">
      <h1>The Board</h1>
      <p class="muted lede">
        All {coins.length} coins on one wall, oldest first within each period and with the same denominations kept
        together. Hover a coin to turn it over; click to open its entry. Every disc is the same size here — the cabinet
        records each coin's real diameter.
      </p>

      {
        groups.map((group) => (
          <section class="period">
            <h2>
              {group.category} <span class="count">{group.items.length}</span>
            </h2>
            <ul class="board">
              {group.items.map((coin) => (
                <li>
                  <a
                    class="tile"
                    href={`/hobbies/coins/${coinSlug(coin)}`}
                    style={ZOOMED.has(coinSlug(coin)) ? "--z: 1.25" : undefined}
                  >
                    <span class="window">
                      {/* One composite holds both faces side by side, so shifting
                          the image by exactly one tile turns the coin over
                          without needing a second file. */}
                      <img
                        class="face"
                        src={coin.image.replace(".webp", "-sm.webp")}
                        alt={`${coin.title}, ${coin.type}`}
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                    <span class="name">{shortName(coin.title)}</span>
                    <span class="sub">{subtitle(coin)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .lede {
    max-width: 62ch;
    margin: 0.6rem 0 0;
  }

  .period {
    margin-top: 3rem;
  }

  .period h2 {
    font-size: 1.15rem;
    margin: 0 0 1.2rem;
  }

  .count {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.1rem 0.5rem;
    border-radius: var(--rounded-pill);
    background: var(--surface-card);
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    vertical-align: middle;
  }

  .board {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 1.6rem 1.1rem;
  }

  .tile {
    display: grid;
    gap: 0.1rem;
    text-decoration: none;
    color: inherit;
  }

  /* A disc rather than a square photograph: the coin reads as a coin, and the
     rectangular edges of the source shot disappear. Not a true cut-out — the
     photo background still sits behind the flan — but every coin is masked the
     same way, which a mix of real cut-outs and circles would not be. */
  .window {
    display: block;
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: var(--surface-soft);
    border: 1px solid var(--hairline);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  /* Source ratios run 1.72 to 2.20, so taking "the left half" of the image
     itself let a sliver of the reverse bleed in on the narrow ones — 8% on the
     Phokaia diobol. Sizing the image to an exact 2:1 box and letting cover crop
     it makes the halves land precisely whatever the source ratio.

     --z magnifies about the element centre, so the translation has to
     compensate: the visible half's centre lands correctly at 25%(z-1) at rest
     and -25%(z+1) turned over. Both reduce to 0% and -50% when z is 1. */
  .face {
    position: absolute;
    top: 0;
    left: 0;
    width: 200%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: translateX(calc(25% * (var(--z, 1) - 1))) scale(var(--z, 1));
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .tile:hover .face,
  .tile:focus-visible .face {
    transform: translateX(calc(-25% * (var(--z, 1) + 1))) scale(var(--z, 1));
  }

  .tile:hover .window,
  .tile:focus-visible .window {
    border-color: var(--ink);
    transform: translateY(-2px);
  }

  .tile:focus-visible {
    outline: none;
  }

  .tile:focus-visible .window {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .name {
    margin-top: 0.55rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.3;
    color: var(--ink);
  }

  .sub {
    font-size: 0.7rem;
    line-height: 1.35;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .face,
    .window {
      transition: none;
    }

    .tile:hover .window,
    .tile:focus-visible .window {
      transform: none;
    }
  }

  @media (max-width: 30rem) {
    .board {
      grid-template-columns: repeat(auto-fill, minmax(6.8rem, 1fr));
      gap: 1.3rem 0.8rem;
    }
  }
</style>
